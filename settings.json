      "serverName": "claude.ai Google Drive"
    }
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/session-info.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/session-git-init.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/session-scratch-init.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_HOME:-$HOME/.claude}/hooks/sessionstart-launch.py\"",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/session-promote-hook.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/scripts/canary-verify.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/session-tmpfs-banner.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/session-gitignore-propagate.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_HOME:-$HOME/.claude}/hooks/userprompt-launch.py\"",
            "timeout": 240
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/userprompt-consent-allowlist.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/userprompt-tmpfs-pressure.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/userprompt-harness-switch.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_HOME:-$HOME/.claude}/hooks/pretool-launch.py\"",
            "timeout": 945
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/pretool-bash-safety.sh\""
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/pretool-block-enterworktree.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/pretool-worktree-guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_HOME:-$HOME/.claude}/hooks/posttool-launch.py\"",
            "timeout": 690
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/posttool-git-checkpoint.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/posttool-git-warn.sh\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_HOME:-$HOME/.claude}/hooks/posttool-failure-launch.py\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_HOME:-$HOME/.claude}/hooks/stop-launch.py\"",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/sessionend-scratch-sweep.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_HOME:-$HOME/.claude}/hooks/subagentstop-producer-gate.py\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_HOME:-$HOME/.claude}/hooks/subagentstart-launch.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
