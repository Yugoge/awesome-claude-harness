            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/pretool-block-enterworktree.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/pretool-worktree-guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_HOME:-$HOME/.claude}/hooks/posttool-launch.py\"",
            "timeout": 690
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/posttool-git-checkpoint.sh\""
