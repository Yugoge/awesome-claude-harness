          {
            "type": "command",
            "command": "python3 \"${CLAUDE_HOME:-$HOME/.claude}/hooks/pretool-launch.py\"",
            "timeout": 945
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/pretool-bash-safety.sh\""
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
