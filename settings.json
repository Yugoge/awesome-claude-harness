            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/session-promote-hook.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/scripts/canary-verify.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/session-tmpfs-banner.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_HOME:-$HOME/.claude}/hooks/session-gitignore-propagate.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
