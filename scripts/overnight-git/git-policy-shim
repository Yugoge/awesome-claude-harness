#!/usr/bin/env bash
# git-policy-shim — Layer-2 PATH `git` POLICY shim (M13).
#
# SEPARATE from the modern-git selector (git-selector) per codex round-2 #7:
# the selector puts a pinned >=2.46 git first on PATH; THIS shim refuses
# main-root / protected-branch ops for an overnight actor. Relaxing the policy
# must never drop the selector, hence two files.
#
# The protected branch is NEVER a literal and NEVER a fixed enumeration of
# names: it is resolved at decision time from the overnight session-state
# record(s) (M3-RESOLUTION, M5-NO-ENUMERATION). When it cannot be resolved the
# shim FAILS CLOSED on branch-protection decisions (M4).
#
# Installed (named `git`) on the overnight actor's PATH ahead of system git via
# the selector dir. Catches normal `git ...` and python subprocess(["git",...])
# whose argv resolves by BASENAME to `git`. It resolves -C / --git-dir /
# --work-tree / GIT_DIR / GIT_WORK_TREE to an effective target and REFUSES
# when that target resolves to MAIN_ROOT or the op touches master/branch-switch.
#
# Activation: only when CLAUDE_OVERNIGHT_ACTOR=1 AND CLAUDE_OVERNIGHT_MAIN_ROOT
# is set. Otherwise it is a transparent pass-through to the real git (so it is
# inert for any non-overnight use and cannot affect normal sessions).
#
# Exit: 2 = blocked (policy); else delegates to the real git's exit code.

set -u

# Resolve the REAL git: the next `git` on PATH after this shim's dir, else the
# system absolute path. CLAUDE_OVERNIGHT_REAL_GIT lets the selector pin it.
_real_git() {
  if [ -n "${CLAUDE_OVERNIGHT_REAL_GIT:-}" ] && [ -x "${CLAUDE_OVERNIGHT_REAL_GIT}" ]; then
    printf '%s' "${CLAUDE_OVERNIGHT_REAL_GIT}"
    return
  fi
  local self_dir cand
  self_dir="$(cd "$(dirname "$0")" && pwd -P)"
  local IFS=:
  for d in $PATH; do
    [ -n "$d" ] || continue
    [ "$(cd "$d" 2>/dev/null && pwd -P)" = "$self_dir" ] && continue
    cand="$d/git"
    if [ -x "$cand" ]; then printf '%s' "$cand"; return; fi
  done
  for cand in /usr/bin/git /usr/local/bin/git /bin/git; do
    [ -x "$cand" ] && { printf '%s' "$cand"; return; }
  done
  printf '%s' git
}
REAL_GIT="$(_real_git)"

# Inert unless we are the overnight actor with a known main root.
if [ "${CLAUDE_OVERNIGHT_ACTOR:-}" != "1" ] || [ -z "${CLAUDE_OVERNIGHT_MAIN_ROOT:-}" ]; then
  exec "$REAL_GIT" "$@"
fi

MAIN_ROOT="$(cd "${CLAUDE_OVERNIGHT_MAIN_ROOT}" 2>/dev/null && pwd -P || printf '%s' "${CLAUDE_OVERNIGHT_MAIN_ROOT}")"

# Every block emits EXACTLY ONE dedicated machine-readable line carrying
# exactly one `reason=` field and at most one `ref=` field (M4-REASON-TOKENS).
# The reason token is a CONSTANT — never interpolated from the ref or branch
# name. Human-readable prose goes on a SEPARATE line so the structured line
# stays unambiguously parseable.
_blocked_tok() {
  # $1 = reason token (constant), $2 = ref verbatim (may be empty), $3 = prose
  if [ -n "${2:-}" ]; then
    echo "OVERNIGHT-SHIM-DENY reason=$1 ref=$2" >&2
  else
    echo "OVERNIGHT-SHIM-DENY reason=$1" >&2
  fi
  echo "OVERNIGHT POLICY SHIM: refused git op ($3). Overnight actors are confined to the isolated worktree." >&2
  exit 2
}
# Path/dir-based blocks. These are NOT branch-name decisions; `main_targeting`
# is the OPTIONAL diagnostic token of M4-REASON-TOKENS and no criterion depends
# on it. It is emitted for consistency of the structured line only.
_blocked() {
  _blocked_tok 'main_targeting' '' "$1"
}

# Parse the leading git global options to find -C / --git-dir / --work-tree and
# the subcommand. We resolve an effective directory target.
eff_dir=""
git_dir=""
work_tree=""
subcmd=""
args=("$@")
i=0
n=${#args[@]}
while [ $i -lt $n ]; do
  a="${args[$i]}"
  case "$a" in
    -C)        i=$((i+1)); eff_dir="${args[$i]:-}" ;;
    -C*)       eff_dir="${a#-C}" ;;
    --git-dir) i=$((i+1)); git_dir="${args[$i]:-}" ;;
    --git-dir=*) git_dir="${a#--git-dir=}" ;;
    --work-tree) i=$((i+1)); work_tree="${args[$i]:-}" ;;
    --work-tree=*) work_tree="${a#--work-tree=}" ;;
    -c)        i=$((i+1)) ;;  # skip -c key=val
    -c*)       : ;;
    --exec-path|--exec-path=*|--no-pager|--paginate|-p|-P|--bare|--no-replace-objects|--literal-pathspecs|--glob-pathspecs|--noglob-pathspecs|--icase-pathspecs|--no-optional-locks) : ;;
    --namespace|--super-prefix) i=$((i+1)) ;;
    -*)        : ;;
    *)         subcmd="$a"; break ;;
  esac
  i=$((i+1))
done

# Env-based targets
[ -n "${GIT_WORK_TREE:-}" ] && work_tree="${GIT_WORK_TREE}"
[ -n "${GIT_DIR:-}" ] && git_dir="${GIT_DIR}"

# Compute the effective working directory for the op.
_resolve() { ( cd "${1:-.}" 2>/dev/null && pwd -P ) || printf '%s' "$1"; }
target_dir="$(_resolve "${eff_dir:-${work_tree:-.}}")"
# VECTOR-2 (Cycle-3): the --work-tree / GIT_WORK_TREE override is the ACTUAL
# write target even when -C points inside the isolated worktree (the index/HEAD
# come from -C's repo but the checkout/restore TARGET is the work-tree). Resolve
# it independently so a work-tree redirect into main is evaluated for
# main-targeting regardless of -C. Empty when no override was given.
worktree_target=""
[ -n "${work_tree:-}" ] && worktree_target="$(_resolve "${work_tree}")"

# fix-3 (Cycle-2): "under main_root but OUTSIDE every active worktree" is
# main-targeting. The active worktrees are the overnight worktree(s); we treat
# CLAUDE_OVERNIGHT_WORKTREE (set by overnight-git-env.sh) plus the conventional
# .claude/worktrees/* prefix as the allow-set. Replaces the prior exact-root
# equality (which let `git -C $MAIN/sub …` evade by resolving to a subdir).
_under() {
  # _under <path> <prefix> : true iff realpath(path) == prefix or under prefix/
  case "$1" in
    "$2") return 0 ;;
    "$2"/*) return 0 ;;
  esac
  return 1
}
_is_under_a_worktree() {
  local d="$1"
  [ -n "$d" ] || return 1
  if [ -n "${CLAUDE_OVERNIGHT_WORKTREE:-}" ]; then
    local wt
    wt="$(cd "${CLAUDE_OVERNIGHT_WORKTREE}" 2>/dev/null && pwd -P || printf '%s' "${CLAUDE_OVERNIGHT_WORKTREE}")"
    _under "$d" "$wt" && return 0
  fi
  case "$d" in
    "$MAIN_ROOT"/.claude/worktrees/*) return 0 ;;
    "$MAIN_ROOT"/.claude/overnight-fresh-clones/*) return 0 ;;
  esac
  return 1
}
_targets_main() {
  # main-targeting iff the effective dir is under main_root AND not under any
  # active worktree (a worktree lives physically under .claude/worktrees but is
  # an independent checkout; a plain subdir of main is NOT).
  local d="$1"
  _under "$d" "$MAIN_ROOT" || return 1
  _is_under_a_worktree "$d" && return 1
  return 0
}

# If git_dir / GIT_DIR / GIT_COMMON_DIR is given and points into MAIN_ROOT/.git,
# treat as main (codex #6: redirect-into-main).
_gitdir_into_main() {
  [ -n "$1" ] || return 1
  local gd
  gd="$(_resolve "$1")"
  case "$gd" in
    "$MAIN_ROOT"/.git|"$MAIN_ROOT"/.git/*|"$MAIN_ROOT") return 0 ;;
  esac
  return 1
}
if _gitdir_into_main "$git_dir"; then
  _blocked "--git-dir/GIT_DIR -> main"
fi
if _gitdir_into_main "${GIT_COMMON_DIR:-}"; then
  _blocked "GIT_COMMON_DIR -> main"
fi

# Block any op whose effective directory is main-targeting (under main_root but
# outside any active worktree).
if _targets_main "$target_dir"; then
  _blocked "-C/cwd -> main (under main_root, outside worktree)"
fi

# VECTOR-2 (Cycle-3): a --work-tree / GIT_WORK_TREE override pointing at the main
# working directory (under main_root, outside every active worktree) writes the
# main tree in place even when -C is the worktree. Block before execution.
if [ -n "$worktree_target" ] && _targets_main "$worktree_target"; then
  _blocked "--work-tree/GIT_WORK_TREE -> main (writes the main working directory)"
fi

# Block dangerous/mutating ops that touch master or move HEAD, BUT only when they
# are main-targeting or move the protected `master` ref — a worktree-local
# checkout/switch/reset is a LEGITIMATE op and is ALLOWED (codex #2/#6: no
# all-checkout overblocking).
_op_is_main_targeting="$( _targets_main "$target_dir" && echo 1 || echo 0 )"
# VECTOR-2: a work-tree override into main also makes the op main-targeting.
if [ -n "$worktree_target" ] && _targets_main "$worktree_target"; then
  _op_is_main_targeting=1
fi
_in_worktree="$( _is_under_a_worktree "$target_dir" && echo 1 || echo 0 )"

# ==========================================================================
# PROTECTED-BRANCH RESOLUTION (M3-RESOLUTION) — shim copy
# ==========================================================================
# Identical semantics to the keystone's resolution, plus candidate root K4
# (CLAUDE_OVERNIGHT_MAIN_ROOT), which is admissible HERE and not in the
# keystone: the shim is already wholly inert without that variable (see the
# activation gate above), so consuming it adds no attack surface the shim does
# not already have. The union is ADDITIVE ONLY, so K4 can only over-protect.
#
# Deliberately INLINED rather than sourced: overnight-git-env.sh installs this
# file as a SINGLE copy into the actor's policy bindir, so a sibling library
# would not exist at the install location.
_OBP_RESOLVED=0        # memo guard: resolve at most ONCE per shim invocation
_OBP_SET=""            # newline-delimited protected names

_obp_subdirs() {
  printf '%s\n' '.claude'
  if [ -n "${OVERNIGHT_STATE_SUBDIR:-}" ] && [ "${OVERNIGHT_STATE_SUBDIR}" != ".claude" ]; then
    printf '%s\n' "${OVERNIGHT_STATE_SUBDIR}"
  fi
}
# EXCLUDED only when the record declares a NON-NULL isolation_released_at. This
# is the only subtractive operator in the resolution; no other filter may be
# added (each would be a subtraction an actor could influence).
_obp_is_released() {
  grep -qE '"isolation_released_at"[[:space:]]*:[[:space:]]*null' "$1" 2>/dev/null && return 1
  grep -qE '"isolation_released_at"[[:space:]]*:' "$1" 2>/dev/null && return 0
  return 1
}
# Absent field contributes NOTHING (M6 case (ii)) -> empty set -> same
# fail-closed path as the no-record case.
_obp_field() {
  sed -n 's/.*"protected_branch"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1" 2>/dev/null | head -n1
}
_obp_scan_root() {
  local root="$1" sub f val
  local found=1
  [ -n "$root" ] && [ -d "$root" ] || return 1
  while IFS= read -r sub; do
    [ -n "$sub" ] || continue
    [ -d "$root/$sub" ] || continue
    for f in "$root/$sub"/overnight-state-*.json; do
      [ -f "$f" ] || continue
      found=0
      _obp_is_released "$f" && continue
      val="$(_obp_field "$f")"
      if [ -n "$val" ]; then
        _OBP_SET="$_OBP_SET$val
"
      fi
    done
  done <<EOF
$(_obp_subdirs)
EOF
  return $found
}
# Bounded ancestor walk: stops at the filesystem root and at a mount boundary,
# and cannot follow a symlink out of the tree because it walks a PHYSICAL
# (pwd -P) path by string truncation rather than by chdir.
_obp_walk_up() {
  local start="$1" dir dev0 dev
  [ -n "$start" ] && [ -d "$start" ] || return 0
  dir="$(cd "$start" 2>/dev/null && pwd -P)" || return 0
  [ -n "$dir" ] || return 0
  dev0="$(stat -c %d "$dir" 2>/dev/null || echo '')"
  while [ -n "$dir" ]; do
    dev="$(stat -c %d "$dir" 2>/dev/null || echo '')"
    if [ -n "$dev0" ] && [ -n "$dev" ] && [ "$dev" != "$dev0" ]; then break; fi
    _obp_scan_root "$dir" >/dev/null 2>&1 || true
    [ "$dir" = "/" ] && break
    dir="${dir%/*}"
    [ -n "$dir" ] || dir="/"
  done
}
_obp_origin_root() {
  local url gd
  url="$("$REAL_GIT" config --get remote.origin.url 2>/dev/null || echo '')"
  case "$url" in
    ''|*://*|*@*:*) return 0 ;;
  esac
  [ -d "$url" ] || return 0
  gd="$(cd "$url" 2>/dev/null && pwd -P)" || return 0
  printf '%s\n' "${gd%/*}"
}
_obp_resolve() {
  [ "$_OBP_RESOLVED" = "1" ] && return 0
  _OBP_RESOLVED=1
  local cd_abs k1="" k2_needed=1 k3="" top
  # K4 — the shim's own activation context.
  _obp_scan_root "$MAIN_ROOT" >/dev/null 2>&1 || true
  # K1 — parent of the git common dir (git's own resolution, not cwd/env).
  cd_abs="$("$REAL_GIT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo '')"
  if [ -n "$cd_abs" ]; then
    cd_abs="$(cd "$cd_abs" 2>/dev/null && pwd -P || printf '%s' "$cd_abs")"
    k1="${cd_abs%/*}"
    if _obp_scan_root "$k1"; then k2_needed=0; fi
  fi
  # K2 — bounded ancestor walk from the repository toplevel.
  if [ "$k2_needed" = "1" ]; then
    top="$("$REAL_GIT" rev-parse --path-format=absolute --show-toplevel 2>/dev/null || echo '')"
    [ -n "$top" ] || top="$(pwd -P 2>/dev/null || echo '')"
    _obp_walk_up "$top"
  fi
  # K3 — the local origin's parent (fresh clone relocated outside main root).
  k3="$(_obp_origin_root)"
  [ -n "$k3" ] && _obp_scan_root "$k3" >/dev/null 2>&1
  return 0
}
_obp_set_is_empty() {
  printf '%s' "$_OBP_SET" | grep -q '[^[:space:]]' && return 1
  return 0
}
# Exact string equality against a value READ FROM THE RECORD — never a pattern,
# prefix, regex or name shape.
_obp_is_protected() {
  local want="$1" name
  [ -n "$want" ] || return 1
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    [ "$name" = "$want" ] && return 0
  done <<EOF
$_OBP_SET
EOF
  return 1
}

# Operand normalisation (M5-OPERANDS). Reduces one argv token to the branch
# name(s) it can denote, covering the forms the prior literal matcher missed:
#   bare <N> | refs/heads/<N> | heads/<N> | <N>@{0}
#   refspecs <N>:<N> | +<N>:refs/heads/<N> | refs/heads/<N>:refs/heads/<N>
# Every transformation here is a STRUCTURAL ref-namespace normalisation
# (namespace prefixes and reflog suffixes). None of them inspects the branch
# NAME, so none is a name-shape gate under AC-7.
_obp_operand_names() {
  local a="${1#+}" part rest
  rest="$a"
  while [ -n "$rest" ]; do
    case "$rest" in
      *:*) part="${rest%%:*}"; rest="${rest#*:}" ;;
      *)   part="$rest"; rest="" ;;
    esac
    part="${part%%@\{*}"          # drop a reflog/revision suffix: <N>@{0}
    case "$part" in
      refs/heads/*) part="${part#refs/heads/}" ;;
      heads/*)      part="${part#heads/}" ;;
    esac
    [ -n "$part" ] && printf '%s\n' "$part"
  done
}

# True iff any argv token denotes a branch in the RESOLVED protected set.
_mentions_protected() {
  local a name
  for a in "$@"; do
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      _obp_is_protected "$name" && return 0
    done <<EOF
$(_obp_operand_names "$a")
EOF
  done
  return 1
}

# The single branch-protection decision seam. Emits the structured denial and
# exits; returns normally when the operand set carries no protected name.
# Fail-closed (M4): an unresolvable protected set blocks the ref-affecting op
# rather than leaving it silently unprotected.
_branch_protection_gate() {
  local subcmd_label="$1"; shift
  local a name
  _obp_resolve
  if _obp_set_is_empty; then
    _blocked_tok 'unresolved_protected_branch' '' \
"$subcmd_label — no live overnight session-state record declares a 'protected_branch' (the field is missing, or no record is discoverable under any candidate governing root). Protection cannot be enforced, so the operation is refused rather than left silently unprotected. Remedy: release this session with /stop and relaunch"
  fi
  for a in "$@"; do
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      if _obp_is_protected "$name"; then
        _blocked_tok 'branch_protected' "refs/heads/$name" \
          "$subcmd_label targeting the protected branch '$name'"
      fi
    done <<EOF
$(_obp_operand_names "$a")
EOF
  done
  return 0
}
case "$subcmd" in
  checkout|switch|reset|restore|clean|rebase|merge|cherry-pick|am|pull|stash)
    # A branch/tree mutation. Block when main-targeting, or when the effective
    # dir cannot be proven to be inside an isolated worktree (fail-closed for the
    # HEAD-moving forms), or when it force-moves master.
    if [ "$_op_is_main_targeting" = "1" ] || _mentions_master "$@"; then
      _blocked "$subcmd (main-targeting / master)"
    fi
    if [ "$_in_worktree" != "1" ] && { [ "$subcmd" = "checkout" ] || [ "$subcmd" = "switch" ] || [ "$subcmd" = "reset" ]; }; then
      # cwd/-C is not provably inside a worktree -> a branch/HEAD move could land
      # on main. Fail closed (the exact 2026-06-03 incident shape).
      _blocked "$subcmd (effective dir not provably inside an isolated worktree)"
    fi
    ;;
  branch)
    # Force-move / rename / delete of `master` is a master ref-move -> block.
    if _mentions_master "$@" || [ "$_op_is_main_targeting" = "1" ]; then
      for a in "$@"; do
        case "$a" in
          -f|-D|-M|--force|--delete|--move) _blocked "branch force/move/delete (master ref-move)" ;;
        esac
      done
    fi
    ;;
  update-ref|symbolic-ref)
    # update-ref refs/heads/master / symbolic-ref HEAD -> protected ref move.
    if _mentions_master "$@" || [ "$_op_is_main_targeting" = "1" ]; then
      _blocked "$subcmd (master/HEAD ref move)"
    fi
    case "$subcmd" in
      symbolic-ref)
        for a in "$@"; do [ "$a" = "HEAD" ] && [ "$_in_worktree" != "1" ] && _blocked "symbolic-ref HEAD (not provably in worktree)"; done ;;
    esac
    ;;
  worktree)
    _blocked "worktree (overnight actor may not manage worktrees)"
    ;;
esac

exec "$REAL_GIT" "$@"
