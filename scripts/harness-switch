#!/usr/bin/env python3
"""harness-switch: the owner's switch for one harness home, /harness off | on | status.

    hook      the UserPromptSubmit path (hooks/userprompt-harness-switch.sh): reads the
              payload on stdin and acts on a typed `/harness off|on|status`. It is the only
              path that switches: the owner's typed prompt is the one event an agent cannot
              produce (commands/harness.md says what else refuses an agent). A session that
              was started from inside another Claude Code session (a `claude` an agent's
              script launched) is not the owner's: off and on are refused there (nested_claude).
              Any other prompt the hook hands over (session_notes): with --late (its process never
              ran the harness's SessionStart hooks) the harness's session start, done late while
              on; in both states, while its command output is on a memory-backed volume, one line.
    status    print the switch's state (read-only). Exit 0 on, 3 off, 4 partial.

The harness home H is the directory above scripts/ (symlinks resolved): a git checkout of the
harness that is also the Claude Code configuration directory (~/.claude, or the directory
CLAUDE_CONFIG_DIR names), as the full install makes it. One account config dir per account
means one clone per account: a switch covers exactly the home it is typed in.

/harness off, in this order, each step recorded in <H>/.harness-switch/journal.json first:
  save      settings.json's bytes (settings.on.json) and the sparse-checkout config
  marker    <H>/.harness-switch/off: from here no harness hook runs, in this session too, and no
            background job of the harness acts (hooks/lib/harness_switch.{py,sh}). One file
            decides, so the hooks are all on or all off.
  state     state.json: mode, since, the switching session, last_off_at
  overnight every live /dev-overnight run the session can find is ended (its record's
            harness_off_at, through hooks/lib/overnight.py), so on arms no time-lock
  settings  settings.json in its off form (scripts/install/render-settings "the harness
            switch"): no harness hook, env var or permission rule from the next session on
  hide      a sparse checkout leaves CLAUDE.md, commands/ (but commands/harness.md), agents/
            and skills/ out of the working tree, so the next session loads none of them; git
            keeps them in the index, so a pull while off works and lands them hidden
/harness on reverses it: show, settings (the saved bytes when nothing changed; else the new
machine form with the owner's changes made while off), marker, state, cleanup, then a token in
<H>/.harness-switch/late per running Claude Code process: its one late session start.

A switch cut halfway leaves its journal: status names the step it reached, and the next
/harness off or on first finishes the cut switch, then does what was asked. Two switches never
run at once (an exclusive lock, released with its process). Stdlib only.
"""
import contextlib
import copy
import datetime
import fcntl
import glob
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import time

HOME = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
SW = os.path.join(HOME, ".harness-switch")
MARKER = os.path.join(SW, "off")
STATE = os.path.join(SW, "state.json")
JOURNAL = os.path.join(SW, "journal.json")
SAVED = os.path.join(SW, "settings.on.json")    # settings.json as it was before off
WRITTEN = os.path.join(SW, "settings.off.json")  # the off form off wrote
SPARSE_SAVED = os.path.join(SW, "sparse.json")
LOCK = os.path.join(SW, "lock")
LATE = os.path.join(SW, "late")  # <pid>-<start>: an empty file per process at /harness on, its late start not run
SETTINGS = os.path.join(HOME, "settings.json")
OVERLAY = os.path.join(HOME, "settings.machine.json")

HIDDEN = ("CLAUDE.md", "commands", "agents", "skills")  # what the next session would load
KEPT_COMMAND = "commands/harness.md"
SPARSE_HEADER = "# harness-switch: /harness off hides the harness's prompts; /harness on removes this"
SPARSE_PATTERNS = ("/*", "!/CLAUDE.md", "!/commands/*", "/" + KEPT_COMMAND, "!/agents/", "!/skills/")
WAKE_TAG = "[awesome-claude-harness/overnight-wake-v1]"  # hooks/lib/overnight.py WAKE_PROMPT
OFF_STEPS = ("save", "marker", "state", "overnight", "settings", "hide")
ON_STEPS = ("show", "settings", "marker", "state", "cleanup")
EXIT_ON, EXIT_OFF, EXIT_PARTIAL = 0, 3, 4

_COMMAND = re.compile(r"\s*(?:<command-message>.*?</command-message>\s*)?<command-name>/?harness"
                      r"</command-name>(?:\s*<command-args>(.*?)</command-args>)?\s*\Z", re.S)
_TYPED = re.compile(r"\s*/harness(?:\s+(.*?))?\s*\Z", re.S)


class SwitchError(Exception):
    """A step could not complete; the journal keeps where it stopped."""


# ----------------------------------------------------------------------------------- files

def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_bytes(path):
    try:
        with open(path, "rb") as fh:
            return fh.read()
    except FileNotFoundError:
        return None


def read_json(path):
    data = read_bytes(path)
    if data is None:
        return None
    try:
        value = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        return None
    return value if isinstance(value, dict) else None


def write_atomic(path, data, mode=0o600):
    """Write `data` (bytes) to `path` by rename, keeping an existing file's mode."""
    try:
        mode = os.stat(path).st_mode & 0o7777
    except FileNotFoundError:
        pass
    tmp = "%s.%d.tmp" % (path, os.getpid())
    with open(tmp, "wb") as fh:
        fh.write(data)
        fh.flush()
        os.fsync(fh.fileno())
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def write_json(path, obj):
    write_atomic(path, (json.dumps(obj, indent=2, ensure_ascii=False) + "\n").encode("utf-8"))


def remove(path):
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


def sha(data):
    return hashlib.sha256(data).hexdigest() if data is not None else None


def git(*args, check=False):
    proc = subprocess.run(["git", "-C", HOME, *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                          stdin=subprocess.DEVNULL)
    out = proc.stdout.decode("utf-8", "replace").strip()
    if check and proc.returncode != 0:
        raise SwitchError("git %s: %s" % (" ".join(args), proc.stderr.decode("utf-8", "replace").strip()))
    return proc.returncode, out, proc.stderr.decode("utf-8", "replace").strip()


def git_out(*args):
    rc, out, _ = git(*args)
    return out if rc == 0 else None


def is_checkout():
    top = git_out("rev-parse", "--show-toplevel")
    return bool(top) and os.path.realpath(top) == HOME


def render_settings():
    """scripts/install/render-settings as a module: the one definition of the off form."""
    path = os.path.join(HOME, "scripts", "install", "render-settings")
    loader = importlib.machinery.SourceFileLoader("_harness_switch_render_settings", path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


# ------------------------------------------------------------------------------- settings

def clean_form(rs):
    data = rs.clean_source(HOME)
    base = rs.parse(data) if data is not None else None
    if base is None:
        raise SwitchError("the clean form of settings.json (the index, else HEAD) is not a JSON object")
    return base


def settings_blob():
    return git_out("rev-parse", ":settings.json")


def settings_off(state, report):
    """Write the off form of the working settings.json; record what was written. A file that is
    missing or not a JSON object is left as it is, and the report says so."""
    rs = render_settings()
    data = read_bytes(SETTINGS)
    working = rs.parse(data) if data is not None else None
    if working is None:
        report.append("settings.json is missing or not a JSON object, so it was left as it is; fix it, "
                      "then /harness off again")
        return
    off = rs.off_form(working, clean_form(rs))
    out = rs.canon(off)
    if out != data:
        rs._write_atomic(SETTINGS, out)
    write_atomic(WRITTEN, out)
    for key in rs.OFF_KEEPS_ENV:  # the temp directories the off form keeps: no hook makes them while off
        path = (off.get("env") or {}).get(key)
        if isinstance(path, str) and os.path.isabs(path) and not os.path.isdir(path):
            try:
                os.makedirs(path)
                os.chmod(path, 0o1777)
            except OSError as exc:
                report.append("env.%s names %s, which could not be created (%s)" % (key, path, exc))
    if is_checkout():
        rs.refresh_index(HOME)
    state.update(settings_blob=settings_blob(), overlay_sha=sha(read_bytes(OVERLAY)))


def _diff(a, b, path=()):
    """Operations that turn object a into object b: ('set', path, value), ('del', path) and,
    for lists, ('list', path, removed, added)."""
    if isinstance(a, dict) and isinstance(b, dict):
        ops = [("del", path + (k,)) for k in a if k not in b]
        for k in b:
            if k not in a:
                ops.append(("set", path + (k,), b[k]))
            elif a[k] != b[k]:
                ops.extend(_diff(a[k], b[k], path + (k,)))
        return ops
    if isinstance(a, list) and isinstance(b, list):
        return [("list", path, [x for x in a if x not in b], [x for x in b if x not in a])]
    return [("set", path, b)]


def _apply(ops, obj):
    for op in ops:
        path = op[1]
        parent = obj
        for key in path[:-1]:
            if not isinstance(parent.get(key), dict):
                parent[key] = {}
            parent = parent[key]
        if not path:
            continue
        last = path[-1]
        if op[0] == "set":
            parent[last] = copy.deepcopy(op[2])
        elif op[0] == "del":
            parent.pop(last, None)
        else:
            lst = parent.get(last)
            if not isinstance(lst, list):
                lst = parent[last] = []
            lst[:] = [x for x in lst if x not in op[2]]
            lst.extend(copy.deepcopy(x) for x in op[3] if x not in lst)
    return obj


def settings_on(state):
    """Restore settings.json: the saved bytes when nothing changed while off; the saved form with
    the owner's changes when only the owner changed it; the machine form of the new clean form,
    with the owner's changes, after a pull or an overlay change."""
    rs = render_settings()
    current = read_bytes(SETTINGS)
    saved, written = read_bytes(SAVED), read_bytes(WRITTEN)
    working = rs.parse(current) if current is not None else None
    same_source = (saved is not None and written is not None
                   and state.get("settings_blob") == settings_blob()
                   and state.get("overlay_sha") == sha(read_bytes(OVERLAY)))
    if same_source and current == written:
        out = saved
    elif same_source and working is not None and rs.parse(saved) is not None:
        out = rs.canon(_apply(_diff(rs.parse(written), working), rs.parse(saved)))
    else:
        if working is None:
            working = rs.parse(written) if written is not None else {}
        layers = rs.layers_of(rs.load_overlay(HOME))
        target = rs.on_form(working, clean_form(rs), layers)
        before = rs.parse(saved) if saved is not None else None
        for key in rs.CLI_OWNED:  # git rewrites the whole file on a pull: the CLI's keys come back
            if before and key in before and key not in working:
                target[key] = before[key]
        out = rs.canon(target)
    if out != current:
        rs._write_atomic(SETTINGS, out)
    if is_checkout():
        rs.refresh_index(HOME)


# --------------------------------------------------------------------------------- sparse

def sparse_file():
    rel = git_out("rev-parse", "--git-path", "info/sparse-checkout")
    return os.path.join(HOME, rel) if rel else None


def config_scope():
    """Where this checkout's sparse settings live: the worktree's config once git uses one (as
    `git sparse-checkout` turns on), else the repository's."""
    return "--worktree" if git_out("config", "--bool", "--get", "extensions.worktreeConfig") == "true" \
        else "--local"


def sparse_config():
    return {key: git_out("config", config_scope(), "--get", key)
            for key in ("core.sparseCheckout", "core.sparseCheckoutCone")}


def set_config(key, value):
    if value is None:
        git("config", config_scope(), "--unset", key)
    else:
        git("config", config_scope(), key, value, check=True)


def sparse_save():
    path = sparse_file()
    data = read_bytes(path) if path else None
    write_json(SPARSE_SAVED, {"config": sparse_config(),
                              "file": data.decode("utf-8", "replace") if data is not None else None})


def ours(path):
    data = read_bytes(path) if path else None
    return data is not None and data.decode("utf-8", "replace").startswith(SPARSE_HEADER)


def visible_hidden():
    """Tracked files of the hidden paths still in the working tree (git keeps a file with local
    changes when its sparse pattern goes)."""
    rc, out, _ = git("ls-files", "-t", "--", *HIDDEN)
    if rc != 0:
        return []
    found = []
    for line in out.splitlines():
        tag, _, rel = line.partition(" ")
        if rel and rel != KEPT_COMMAND and os.path.lexists(os.path.join(HOME, rel)):
            found.append(rel)
    return found


def hide(report):
    if not is_checkout():
        report.append("not hidden: %s is not a git checkout, so CLAUDE.md, commands, agents and skills "
                      "stay" % HOME)
        return
    saved = read_json(SPARSE_SAVED) or {}
    path = sparse_file()
    if (saved.get("config") or {}).get("core.sparseCheckout") == "true" and not ours(path):
        report.append("not hidden: the home already uses a sparse checkout of its own, which the switch "
                      "leaves as it is")
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    write_atomic(path, ("\n".join((SPARSE_HEADER,) + SPARSE_PATTERNS) + "\n").encode("utf-8"), 0o644)
    set_config("core.sparseCheckoutCone", "false")
    set_config("core.sparseCheckout", "true")
    rc, _, err = git("sparse-checkout", "reapply")
    if rc != 0:
        report.append("not hidden: git sparse-checkout reapply failed (%s); git 2.27 or later is needed"
                      % (err.splitlines() or ["no message"])[-1])
        return
    kept = visible_hidden()
    if kept:
        report.append("still visible (local changes, which git keeps): " + ", ".join(kept[:8])
                      + (" and %d more" % (len(kept) - 8) if len(kept) > 8 else "")
                      + "; commit or move them, then /harness off again")


def show():
    if not is_checkout():
        return
    saved = read_json(SPARSE_SAVED)
    path = sparse_file()
    if saved is None:  # nothing was saved: undo only what is ours
        if not ours(path):
            return
        saved = {"config": {"core.sparseCheckout": None, "core.sparseCheckoutCone": None}, "file": None}
    config = saved.get("config") or {}
    if config.get("core.sparseCheckout") == "true" and not ours(path):
        return  # the owner's own sparse checkout, never touched
    if sparse_config().get("core.sparseCheckout") == "true":  # every hidden file back, as HEAD has it
        write_atomic(path, b"/*\n", 0o644)
        git("sparse-checkout", "reapply", check=True)
    if saved.get("file") is None:
        remove(path)
    else:
        write_atomic(path, saved["file"].encode("utf-8"), 0o644)
    for key, value in config.items():
        set_config(key, value)
    if config.get("core.sparseCheckout") == "true":
        git("sparse-checkout", "reapply")


# ------------------------------------------------------------------------------- switching

def record_history(state, mode, when):
    """The last switches (time, mode): which mode a session started under decides its restart."""
    history = [h for h in state.get("history") or [] if isinstance(h, list) and len(h) == 2]
    state["history"] = (history + [[when, mode]])[-20:]


def mode_at(state, when):
    """The mode the switch was in at `when` (an ISO time), "on" before any switch."""
    mode = "on"
    for stamp, value in state.get("history") or []:
        if isinstance(stamp, str) and stamp <= when:
            mode = value
    return mode


def end_overnight(ctx, when):
    """End every live /dev-overnight run whose record the session can find (hooks/lib/overnight.py:
    the payload's project, CLAUDE_PROJECT_DIR, the working directory, its git top level), through
    the record's one writer: its `harness_off_at` makes every verdict on it False, so after
    /harness on it arms no time-lock and holds no isolation."""
    lib = os.path.join(HOME, "hooks", "lib", "overnight.py")
    spec = importlib.util.spec_from_file_location("_harness_switch_overnight", lib)
    overnight = importlib.util.module_from_spec(spec)
    sys.path.insert(0, os.path.dirname(lib))
    try:
        spec.loader.exec_module(overnight)
    finally:
        sys.path.pop(0)
    ended = []
    for d in overnight.candidate_project_dirs(ctx.get("cwd")):
        for sf in sorted(overnight.Path(d).glob(".claude/overnight-state-*.json")):
            record = overnight.read_state(sf)
            if record is None or str(sf) in ended:
                continue
            verdicts = overnight.state_verdicts(record)
            if verdicts.window_live or verdicts.before_end or verdicts.isolation_held:
                record.update(harness_off_at=when, current_phase="completed")
                overnight.write_state(sf, record)
                ended.append(str(sf))
    return ended


def journal_step(journal, step):
    journal.setdefault("done", []).append(step)
    write_json(JOURNAL, journal)
    if os.environ.get("HARNESS_SWITCH_STOP_AFTER") == "%s:%s" % (journal.get("op"), step):
        os._exit(9)  # tests: a switch killed right after this step (tests/test_harness_switch.py)


def run_off(journal, ctx, report):
    state = read_json(STATE) or {}
    done = journal.setdefault("done", [])
    if "save" not in done:
        data = read_bytes(SETTINGS)
        if data is not None and settings_form() == "on":  # an off form is never the form to restore
            write_atomic(SAVED, data)
        if is_checkout() and not ours(sparse_file()):  # nor is the switch's own sparse checkout
            sparse_save()
        journal_step(journal, "save")
    if "marker" not in done:
        os.makedirs(SW, exist_ok=True)
        write_atomic(MARKER, (journal["started"] + "\n").encode("utf-8"), 0o644)
        journal_step(journal, "marker")
    if "state" not in done:
        if not (journal.get("repair") and state.get("mode") == "off"):
            state.update(mode="off", since=journal["started"], last_off_at=journal["started"],
                         session_id=ctx.get("session_id"))
            record_history(state, "off", journal["started"])
        state["home"] = HOME
        write_json(STATE, state)
        journal_step(journal, "state")
    if "overnight" not in done:
        ended = end_overnight(ctx, journal["started"])
        if ended:
            report.append("ended %d /dev-overnight run(s) that were live: %s" % (len(ended), ", ".join(ended)))
        journal_step(journal, "overnight")
    if "settings" not in done:
        settings_off(state, report)
        write_json(STATE, state)
        journal_step(journal, "settings")
    if "hide" not in done:
        hide(report)
        state["partial"] = list(report)
        write_json(STATE, state)
        journal_step(journal, "hide")
    remove(JOURNAL)


def run_on(journal, ctx, report):
    state = read_json(STATE) or {}
    done = journal.setdefault("done", [])
    if "show" not in done:
        show()
        journal_step(journal, "show")
    if "settings" not in done:
        settings_on(state)
        journal_step(journal, "settings")
    if "marker" not in done:
        remove(MARKER)
        journal_step(journal, "marker")
    if "state" not in done:
        if not (journal.get("repair") and state.get("mode") == "on"):
            state.update(mode="on", since=journal["started"], session_id=ctx.get("session_id"))
            record_history(state, "on", journal["started"])
        state["home"] = HOME
        state.pop("partial", None)
        write_json(STATE, state)
        journal_step(journal, "state")
    for path in (SAVED, WRITTEN, SPARSE_SAVED):
        remove(path)
    arm_late_starts(report)
    remove(JOURNAL)


RUNNERS = {"off": run_off, "on": run_on}


def switch(verb, ctx):
    """Do `verb` ("off" or "on"), first finishing a switch a cut left; returns notes."""
    os.makedirs(SW, mode=0o700, exist_ok=True)
    notes = []
    lock = open(LOCK, "a")
    deadline = time.monotonic() + 20
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError:
            if time.monotonic() > deadline:
                raise SwitchError("another /harness switch of this home is still running")
            time.sleep(0.2)
    try:
        journal = read_json(JOURNAL)
        if journal and journal.get("op") in RUNNERS:
            notes.append("finished the /harness %s that was cut after step %s" % (
                journal["op"], (journal.get("done") or ["(none)"])[-1]))
            report = []
            RUNNERS[journal["op"]](journal, ctx, report)
            notes.extend(report)
        mode = current_mode()
        if mode == verb and not inconsistencies():
            notes.append("the harness was already %s; nothing changed" % verb)
            return notes
        journal = {"op": verb, "started": now(), "done": [], "session_id": ctx.get("session_id"),
                   "repair": mode == verb}  # a repair keeps the switch's time
        write_json(JOURNAL, journal)
        report = []
        RUNNERS[verb](journal, ctx, report)
        return notes + report
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        lock.close()


# --------------------------------------------------------------------------------- status

def current_mode():
    return "off" if os.path.exists(MARKER) else "on"


def settings_form():
    """'off' when the working settings.json carries no harness entry, else 'on' (None: unreadable)."""
    try:
        rs = render_settings()
        working = rs.parse(read_bytes(SETTINGS) or b"")
        if working is None:
            return None
        return "off" if rs.off_form(working, clean_form(rs)) == working else "on"
    except Exception:
        return None


def hidden_state():
    if not is_checkout():
        return None
    return "off" if ours(sparse_file()) and sparse_config().get("core.sparseCheckout") == "true" else "on"


def inconsistencies():
    """What disagrees with the marker, the one switch of the hooks (empty when consistent)."""
    mode, out = current_mode(), []
    journal = read_json(JOURNAL)
    if journal:
        out.append("a /harness %s was cut after step %s (steps: %s); the next /harness off or on "
                   "finishes it first" % (journal.get("op"), (journal.get("done") or ["(none)"])[-1],
                                         ", ".join(OFF_STEPS if journal.get("op") == "off" else ON_STEPS)))
    state = read_json(STATE) or {}
    if state.get("mode") and state["mode"] != mode:
        out.append("the record says %s, the marker says %s" % (state["mode"], mode))
    form = settings_form()
    if form is not None and form != mode:
        out.append("settings.json is in its %s form while the hooks are %s" % (form, mode))
    hidden = hidden_state()
    if hidden is not None and hidden != mode and not (mode == "off" and state.get("partial")):
        out.append("CLAUDE.md, commands, agents and skills are %s while the hooks are %s"
                   % ("hidden" if hidden == "off" else "visible", mode))
    if mode == "off":
        out.extend("partial off: " + p for p in state.get("partial") or [])
    return out


def config_dir():
    """The configuration directory and the home of the settings.json its CLI loads (claude_home.config_home)."""
    sys.path.insert(0, os.path.join(HOME, "hooks", "lib"))
    try:
        from locations import config_home
    finally:
        sys.path.pop(0)
    return os.path.realpath(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")), str(config_home())


def status_lines(ctx):
    mode, state = current_mode(), read_json(STATE) or {}
    problems = inconsistencies()
    label = "PARTIAL" if problems else mode.upper()
    since = state.get("since") or "(no switch recorded)"
    lines = ["Harness: %s%s (switched %s)" % (label, " (hooks " + mode + ")" if problems else "", since),
             "Home: %s, a %s" % (HOME, "git checkout" if is_checkout() else "directory that is not a git checkout")]
    cfg, loads = config_dir()
    lines.append("Config dir: " + ("the same directory (this account's)" if cfg == HOME else
                                   "%s, whose settings.json is this home's: switched by this home" % cfg
                                   if loads == HOME else
                                   "%s, not this home: that account is not switched by this home" % cfg))
    started = process_start(own_pid()) if ctx else None  # its process, not its transcript: a resume keeps that
    loaded = mode_at(state, iso(started)) if started else None
    if loaded is not None and loaded != mode:
        restart = ("yes: this session's process started while the harness was %s and keeps the settings, "
                   "CLAUDE.md, commands and agents it loaded then; its hooks follow the switch at once. "
                   "Restarting is: %s" % (loaded, RESTART % (ctx.get("session_id") or "<session>")))
    elif loaded is not None:
        restart = "no: this session's process loaded the harness %s" % mode
    elif state.get("since"):
        restart = ("for every session whose process started before %s, which keeps what it loaded (its "
                   "hooks follow the switch at once)" % since)
    else:
        restart = "no"
    lines.append("Restart needed: " + restart)
    lines.extend(output_lines(ctx))
    if mode == "off":
        lines.append("In force: no harness hook runs; checkpoint snapshots, the git-fswatch sync, the "
                     "landing, automatic pushes and the keystone are inert; the /dev-overnight runs live "
                     "at the switch are over")
        lines.append("Next session: settings.json without harness hooks, env vars (but %s, which keep "
                     "command output and temp files on the disk) or permission rules; no harness CLAUDE.md, "
                     "commands (but /harness), agents or skills" % " and ".join(render_settings().OFF_KEEPS_ENV))
    lines.append("Kept: MCP servers, plugins, login and credentials, session history, the owner's own "
                 "settings (cleanupPeriodDays and deniedMcpServers too)")
    lines.extend("Partial: " + p for p in problems)
    return lines, (EXIT_PARTIAL if problems else EXIT_OFF if mode == "off" else EXIT_ON)


# ----------------------------------------------------------------------- nested sessions

_RUNTIMES = re.compile(r"(?:node(?:js)?[\d.]*|bun|deno)\Z")


def looks_like_claude(exe, argv):
    """True when a process (its executable path and argument list) is a Claude Code session: the
    native binary `claude` (`claude.exe` as the npm package installs it, bin/claude.exe on every
    platform), the installer's versioned copy (.../claude/versions/<version>), or node/bun running
    the npm package's `claude` script. /proc names a binary replaced by an upgrade while it runs
    `<path> (deleted)`: the same program. A shell script named claude is not."""
    exe = (exe or "").removesuffix(" (deleted)")
    if os.path.basename(exe) in ("claude", "claude.exe") or "/claude/versions/" in exe:
        return True
    if _RUNTIMES.match(os.path.basename(exe)):
        script = next((a for a in argv[1:] if not a.startswith("-")), "")
        return os.path.basename(script) == "claude" or "/@anthropic-ai/claude-code/" in script
    return False


def _process(pid):
    """(parent pid, executable path, argument list) of a process, else None. /proc where there
    is one; `ps` elsewhere (macOS)."""
    try:
        with open("/proc/%d/stat" % pid, "rb") as fh:
            ppid = int(fh.read().rsplit(b")", 1)[1].split()[1])
        try:
            exe = os.readlink("/proc/%d/exe" % pid)
        except OSError:  # another user's process: the name is all there is
            with open("/proc/%d/comm" % pid, encoding="utf-8", errors="replace") as fh:
                exe = fh.read().strip()
        with open("/proc/%d/cmdline" % pid, "rb") as fh:
            argv = [a.decode("utf-8", "replace") for a in fh.read().split(b"\0") if a]
        return ppid, exe, argv
    except (OSError, ValueError, IndexError):
        pass
    try:
        out = subprocess.run(["ps", "-o", "ppid=", "-o", "comm=", "-p", str(pid)], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL, timeout=5).stdout.decode()
        ppid, _, exe = out.strip().partition(" ")
        args = subprocess.run(["ps", "-o", "args=", "-p", str(pid)], stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL, timeout=5).stdout.decode()
        return int(ppid), exe.strip(), args.split()
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def claude_processes(pid):
    """The Claude Code processes from `pid` up through its ancestors, nearest first, as
    (pid, command)."""
    found, seen = [], set()
    while pid > 1 and pid not in seen:
        seen.add(pid)
        proc = _process(pid)
        if proc is None:
            break
        if looks_like_claude(proc[1], proc[2]):
            found.append((pid, " ".join(proc[2]) or proc[1]))
        pid = proc[0]
    return found


def nested_claude(pid=None):
    """(pid, command) of a Claude Code process above the session's own, when this hook (its parent
    is `pid`) runs in a session that was started from inside another Claude Code session (an
    agent's script that launched `claude`), else None. The hook's ancestry holds the session's own
    `claude` and, for a nested one, the `claude` above it. The environment cannot tell the two:
    Claude Code sets CLAUDECODE and CLAUDE_CODE_CHILD_SESSION in every session's hooks, a top-level
    one included."""
    found = claude_processes(os.getppid() if pid is None else pid)
    return found[1] if len(found) > 1 else None


# ------------------------------------------------------------ where a session's output lives

# The CLI keeps each command's output in <CLAUDE_CODE_TMPDIR, else $TMPDIR, else /tmp>/claude-<uid>/
# <project>/<session>/tasks, a place it fixes when its process starts: a process started without
# the setting keeps it on a memory-backed /tmp until it ends, whatever the switch does later.
TASKS = re.compile(r"/claude-\d+/[^/]+/[^/]+/tasks\Z")
SID_ARG = re.compile(r"(?:--resume|--session-id|-r)[= ]([0-9A-Za-z_-]+)")
RESTART = ("end this Claude Code process and resume the same session (claude --resume %s); the harness's "
           "/restart does not do this: it resumes interrupted subagents and restarts no process")
LATE_BUDGET = 50  # seconds of the switch hook's 60 (settings.json) the late session start may use


def iso(epoch):
    return datetime.datetime.fromtimestamp(epoch, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def own_pid():
    """The session's Claude Code process: CLAUDE_PID, which the CLI gives its hooks, else the
    nearest `claude` above this one."""
    pid = os.environ.get("CLAUDE_PID", "")
    found = claude_processes(os.getppid()) if not pid.isdigit() else [(int(pid), "")]
    return found[0][0] if found else None


def process_start(pid):
    """When process `pid` started (epoch seconds, from /proc), else None."""
    try:
        with open("/proc/%d/stat" % pid, "rb") as fh:
            ticks = int(fh.read().rsplit(b")", 1)[1].split()[19])
        with open("/proc/stat", "rb") as fh:
            boot = next(int(line.split()[1]) for line in fh if line.startswith(b"btime "))
        return boot + ticks / os.sysconf("SC_CLK_TCK")
    except (OSError, TypeError, ValueError, IndexError, StopIteration):
        return None


def output_dirs(pid, sid):
    """The tasks directories process `pid` has written command output to since it started: one it
    holds open, and one of session `sid`'s whose newest entry is not older than the process (a
    stale directory of an earlier process of the session is not). None: no start time."""
    start = process_start(pid)
    if start is None:
        return None
    found = set()
    with contextlib.suppress(OSError):
        for fd in os.scandir("/proc/%d/fd" % pid):
            with contextlib.suppress(OSError):
                if TASKS.search(os.readlink(fd.path)):
                    found.add(os.readlink(fd.path))
    roots = {os.environ.get("CLAUDE_CODE_TMPDIR"), os.environ.get("TMPDIR"), "/tmp"} - {None, ""}
    for root in roots if sid else ():
        for d in glob.glob(os.path.join(glob.escape(root), "claude-*", "*", glob.escape(sid), "tasks")):
            with contextlib.suppress(OSError, ValueError):
                if max(os.lstat(e.path).st_mtime for e in os.scandir(d)) >= start:
                    found.add(os.path.realpath(d))
    return sorted(found)


def memory_backed(path):
    """True when `path` is on a memory-backed volume, False on the disk, None: no mount table."""
    lib = os.path.join(HOME, "scripts", "seal-attribution-journal.py")  # its mount_class: the one reading
    spec = importlib.util.spec_from_file_location("_harness_switch_mounts", lib)
    mounts = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(mounts)
        return not mounts.mount_class(path)["persistent"]
    except OSError:
        return None


def exposed_dirs(pid, sid):
    """Which of those are on a memory-backed volume ([] none); None: it cannot tell (no /proc or
    mount table, a process it may not read, no command output since the process started)."""
    dirs = output_dirs(pid, sid) if pid else None
    known = [(d, memory_backed(d)) for d in dirs or ()]
    return None if not known or None in dict(known).values() else [d for d, mem in known if mem]


def running_claudes():
    """(pid, argument list, working directory) of every Claude Code process /proc lists, else None."""
    try:
        pids = sorted(int(n) for n in os.listdir("/proc") if n.isdigit())
    except OSError:
        return None
    out = []
    for pid in pids:
        proc = _process(pid)
        if proc is not None and looks_like_claude(proc[1], proc[2]):
            try:
                out.append((pid, proc[2], os.readlink("/proc/%d/cwd" % pid)))
            except OSError:
                out.append((pid, proc[2], "(unreadable)"))
    return out


def output_lines(ctx):
    """The report's lines on where every running Claude Code process keeps its command output."""
    procs = running_claudes()
    if procs is None:
        return ["Command output: could not check where running sessions keep it (no /proc on this system)"]
    me, exposed, unknown = own_pid(), [], []
    for pid, argv, cwd in procs:
        m = SID_ARG.search(" ".join(argv))
        sid = ctx.get("session_id") if pid == me and ctx else m.group(1) if m else None
        found = exposed_dirs(pid, sid)
        if found is None:
            unknown.append("%d (%s)" % (pid, cwd))
        exposed.extend("  project %s, session %s, process %d: %s" % (cwd, os.path.basename(os.path.dirname(d)),
                                                                  pid, d) for d in found or ())
    lines = ["Command output on a memory-backed volume, so a restart is needed (when it fills, every "
             "command of that session fails; /harness on cannot move it):"] + exposed + [
             "  for each: " + RESTART % "<session>"] if exposed else []
    if unknown:
        lines.append("Command output not checked for %d Claude Code process(es) (no command output since "
                     "they started, or not readable): %s" % (len(unknown), ", ".join(unknown)))
    return lines or ["Command output: every running Claude Code process keeps it on the disk"]


def late_token(pid):
    """LATE's file for process `pid` (its pid and /proc start ticks, as the hook names it), else None."""
    try:
        with open("/proc/%d/stat" % pid, "rb") as fh:
            return os.path.join(LATE, "%d-%s" % (pid, fh.read().rsplit(b")", 1)[1].split()[19].decode()))
    except (OSError, ValueError, IndexError, TypeError):
        return None


def arm_late_starts(report):
    """At /harness on: a token for every running Claude Code process, the one late start each may
    still get. The prompt that runs it first removes the token (an unlink needs no space), so no
    later prompt reruns it, whatever its .owner says. A token not written means no late start."""
    tokens = {late_token(p) for p in {p for p, _, _ in running_claudes() or ()} | {own_pid()} if p} - {None}
    try:
        with contextlib.suppress(FileNotFoundError):
            for name in os.listdir(LATE):
                os.unlink(os.path.join(LATE, name))
        os.makedirs(LATE, exist_ok=True)
        for token in tokens:
            os.close(os.open(token, os.O_WRONLY | os.O_CREAT, 0o600))
    except OSError as exc:
        report.append("no late session start for a session whose process started while off (%s): its "
                      "SessionStart hooks run when it restarts: %s" % (exc, RESTART % "<session>"))


def late_setup(payload):
    """Run the harness's SessionStart hooks, as settings.json registers them, for a session whose
    process started while the harness was off and so never ran them; their context."""
    rs = render_settings()
    hooks = ((rs.parse(read_bytes(SETTINGS) or b"") or {}).get("hooks") or {}).get("SessionStart")
    data = json.dumps(dict(payload, hook_event_name="SessionStart", source="resume"))
    deadline = time.monotonic() + LATE_BUDGET
    texts = ["SESSION START, DONE LATE: this session's process started while the harness was off, so the "
             "harness's SessionStart hooks run now, at its first prompt after /harness on. Not done late: "
             "the TMPDIR each command gets from the session-start env file (commands keep settings.json's "
             "TMPDIR), and what the CLI fixed when the process started (where it keeps command output, the "
             "settings env and tools, CLAUDE.md, commands and agents); for those, " + RESTART % payload.get(
                 "session_id")]
    for hook in [h for g in hooks or [] if isinstance(g, dict) for h in g.get("hooks") or []]:
        if not (isinstance(hook, dict) and rs._harness_command(hook)) or rs._switch_command(hook):
            continue
        left = deadline - time.monotonic()
        try:
            proc = subprocess.run(hook["command"], shell=True, input=data, capture_output=True, text=True,
                                  cwd=payload.get("cwd") or None, timeout=max(1, min(hook.get("timeout") or 60, left)))
        except (OSError, subprocess.SubprocessError, TypeError):
            continue
        text = proc.stdout.strip()
        with contextlib.suppress(ValueError, TypeError, KeyError, AttributeError):
            text = json.loads(text)["hookSpecificOutput"]["additionalContext"]
        texts.extend(t for t in (text, proc.stderr.strip() if proc.returncode else "") if t)
    return texts


def claim_late():
    """True for the one prompt that removes this process's token: it runs the late start."""
    try:
        os.unlink(late_token(own_pid() or 0) or "")
        return True
    except OSError:
        return False


def session_notes(payload, late):
    """A prompt that is not /harness: the late session start (`late`: the hook found that this
    session's process never ran the harness's SessionStart hooks) while the harness is on, and in
    either state the line saying that its command output is on a memory-backed volume."""
    sid = payload.get("session_id") if isinstance(payload.get("session_id"), str) else None
    context = late_setup(payload) if late and current_mode() == "on" and claim_late() else []
    found = exposed_dirs(own_pid(), sid) if sid else None
    shown = ("Restart needed: this session's command output is in %s, on a memory-backed volume, since "
             "its process started; when that volume fills, every command fails: %s"
             % (os.path.dirname(found[0]), RESTART % sid)) if found else None
    if shown:
        context.append(shown)
    if context:
        emit("\n".join(context), shown)
    return 0


# ------------------------------------------------------------------------------ entry points

def parse_prompt(prompt):
    """The /harness arguments of a typed prompt (a string), else None."""
    m = _COMMAND.match(prompt) or _TYPED.match(prompt)
    return None if m is None else (m.group(1) or "").strip()


def emit(context, shown=None, block=None):
    if block is not None:
        out = {"decision": "block", "reason": block}
    else:
        out = {"hookSpecificOutput": {"hookEventName": "UserPromptSubmit", "additionalContext": context}}
        if shown:
            out["systemMessage"] = shown
    sys.stdout.write(json.dumps(out) + "\n")


def cmd_hook(late=False):
    try:
        payload = json.loads(sys.stdin.buffer.read().decode("utf-8", "replace") or "{}")
    except ValueError:
        return 0
    if not isinstance(payload, dict) or payload.get("agent_id"):
        return 0  # not a prompt the owner typed in the main session
    prompt = payload.get("prompt") if isinstance(payload.get("prompt"), str) else ""
    if WAKE_TAG in prompt and current_mode() == "off":
        emit(None, block="The harness is off (/harness off): this /dev-overnight wake runs nothing. "
                         "Delete its CronCreate job with CronDelete, or type /harness on.")
        return 0
    args = parse_prompt(prompt)
    if args is None:
        return session_notes(payload, late)
    ctx = {"session_id": payload.get("session_id"), "transcript_path": payload.get("transcript_path"),
           "cwd": payload.get("cwd") if isinstance(payload.get("cwd"), str) else None}
    verb = args.split()[0] if args else "status"
    sys.path.insert(0, os.path.join(HOME, "hooks", "lib")); from harness_switch import VERBS; sys.path.pop(0)  # noqa: E702
    if verb not in VERBS or len(args.split()) > 1:
        emit("HARNESS SWITCH: usage: /harness off | on | status (nothing changed). Tell the owner so.",
             "harness: usage: /harness off | on | status")
        return 0
    notes = []
    outer = nested_claude() if verb != "status" else None
    if outer is not None:
        emit(None, block="harness: /harness %s refused, nothing changed. This session was started from inside "
                         "another Claude Code session (process %d, %s, runs above it), so it is not the owner's: "
                         "only a session the owner started in their own terminal, desktop app or IDE switches "
                         "the harness. Type it there." % (verb, outer[0], outer[1][:120]))
        return 0
    if verb != "status":
        try:
            notes = switch(verb, ctx)
        except Exception as exc:  # the journal keeps the step; the next switch finishes it
            notes = ["the switch stopped: %s: %s" % (type(exc).__name__, exc)]
    lines, _ = status_lines(ctx)
    text = "\n".join(lines + ["Note: " + n for n in notes])
    emit("HARNESS SWITCH (/harness %s) - the UserPromptSubmit hook already did it; relay this report "
         "to the owner verbatim and run nothing:\n%s" % (verb, text), lines[0])
    return 0


def main(argv):
    if argv[:1] == ["hook"]:
        return cmd_hook(argv[1:] == ["--late"])
    if argv[:1] == ["status"]:
        lines, code = status_lines({})
        print("\n".join(lines))
        return code
    sys.stderr.write("usage: harness-switch status   (off and on: type /harness off|on in Claude Code)\n")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
