#!/usr/bin/env bash
# push-guard — the pre-push guard (P11). The installed hooks/git-hooks/pre-push runs it from the top
# of the working tree with git's arguments (<remote> <url>) and input ("<local ref> <local oid>
# <remote ref> <remote oid>" lines). Every object the push sends (rev-list --objects <local oids>
# --not <remote tips>: blobs, trees with their path names, commits and annotated tags with author,
# committer, tagger and message) enters, by its own id, the index of a scratch repository that
# borrows this one's objects; P8's engine (scripts/check-public-core.sh --private-literals) scans it
# with this home's list. A hit refuses the push naming "<type> <id>:<line>", never the value. Only a
# listed no-reply address is left out of the copy it scans (P7b's seeding lists git user.email).
# No list or an empty one: nothing is scanned. It fails closed with one line naming the step and
# writes nothing into this repository; after an error nothing is clean: an input line naming no local
# object, a pushed tip this repository does not hold or (--strict) whose tree it cannot look up, any
# step that cannot list, read or scan refuses. Remote tips: the values git passes and, for a ref new
# to the remote, the branches and tags <url> lists (D18: never the remote-tracking refs, stale after
# an upstream rewrite); a remote tip this repository lacks excludes nothing, so stale history is
# still scanned.
# --strict (first argument; scripts/publish-public, D30): the guard is the one reader and decider of
# the list for a publish too. It fails closed, refusing a list that is missing or holds no literal,
# and first runs P8's engine in its default mode (ledger, residue, the literal rule over every file)
# on a checkout of each pushed tip's tree with the list, so a hit names the file. Every report it
# forwards has each listed literal masked, the longest first.
set -uo pipefail
refuse() { echo "pre-push: push REFUSED by the private-literal guard: $*" >&2; exit 1; }
lits() {  # "<list line> <literal>", read as the engine reads the list
  LC_ALL=C awk '{ sub(/\r$/, ""); sub(/^[ \t]+/, ""); sub(/[ \t]+$/, "") } $0 != "" && !/^#/ { print FNR " " $0 }' "$list" 2>/dev/null
}
mask() {  # stdin to stderr, each listed literal replaced by its list line, the longest first
  LC_ALL=C awk 'FILENAME == ARGV[1] { c = index($0, " "); v = substr($0, c + 1)
      for (j = ++n; j > 1 && length(L[j - 1]) < length(v); j--) { L[j] = L[j - 1]; K[j] = K[j - 1] }
      L[j] = v; K[j] = substr($0, 1, c - 1); next }
    { s = $0; for (j = 1; j <= n; j++) { o = ""; while (i = index(s, L[j])) {
        o = o substr(s, 1, i - 1) "<private-literals.txt line " K[j] ">"; s = substr(s, i + length(L[j])) }; s = o s }
      print s }' <(lits) - >&2
}
strict=; [ "${1-}" != --strict ] || { strict=1; shift; }
engine="$(cd "${BASH_SOURCE[0]%/*}/.." 2>/dev/null && pwd)/check-public-core.sh"
list="$(git rev-parse --path-format=absolute --git-common-dir)" || refuse "cannot find the git directory"
list="${list%/*}/private-literals.txt"
if [ -n "$strict" ]; then [ -n "$(lits)" ] || refuse "strict: private-literals.txt is missing or lists no literal"
else [ -s "$list" ] || exit 0; fi
tips=() not=() new=
while read -r lr lo _ ro || [ -n "$lr" ]; do  # all zeros: a deleted ref (it sends nothing), or a ref new to the remote
  [ -n "$lo" ] || refuse "cannot read the push's input: a line names no local object"
  [ -z "${lo//0}" ] || { tips+=("$lo"); [ -n "${ro//0}" ] || new=1; }; [ -z "${ro//0}" ] || not+=("$ro")
done
[ "${#tips[@]}" -gt 0 ] || exit 0
[ -f "$engine" ] || refuse "scripts/check-public-core.sh is missing"
[ -z "$new" ] || { heads="$(git ls-remote --refs "${2-}" 'refs/heads/*' 'refs/tags/*' 2>/dev/null)" \
  || refuse "cannot read the remote's branches and tags"; not+=($(cut -f1 <<< "$heads")); }
objects="$(git rev-parse --path-format=absolute --git-path objects)" && t="$(mktemp -d)" \
  || refuse "cannot create a scratch directory"
trap 'rm -rf "$t"' EXIT
for tip in "${tips[@]}"; do  # --ignore-missing below is for the remote tips alone; a pushed one must be held
  git cat-file -e "$tip" 2>/dev/null \
    || refuse "cannot list the objects this push sends: a pushed tip is not in this repository"
done
git rev-list --objects --no-object-names --ignore-missing "${tips[@]}" --not "${not[@]}" \
  | git cat-file --batch-check=$'100644 %(objectname)\t%(objecttype) %(objectname)' > "$t/sent" \
  || refuse "cannot list the objects this push sends"
trees=(); [ -z "$strict" ] || for tip in "${tips[@]}"; do
  tree="$(git rev-parse -q --verify "$tip^{tree}" 2>/dev/null)" || refuse "strict: cannot look up the tree of a pushed tip"
  trees+=("$tree")
done
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
for tree in "${trees[@]}"; do  # strict: the engine's default mode on each pushed tree, the files named
  c="$t/tree" && git init -q "$c" && printf '%s\n' "$objects" > "$c/.git/objects/info/alternates" \
    && ! git -C "$c" cat-file -e "$tree:private-literals.txt" 2>/dev/null \
    && git -C "$c" read-tree --reset -u "$tree" && cp "$list" "$c/private-literals.txt" \
    || refuse "strict: cannot check out tree $tree (or it tracks private-literals.txt)"
  report="$(cd "$c" && bash "$engine" 2>&1)" \
    || { mask <<< "$report"; refuse "strict: scripts/check-public-core.sh failed on tree $tree (files named above)"; }
  rm -rf "$c"
done
cd "$t" && git init -q . 2>/dev/null && printf '%s\n' "$objects" > .git/objects/info/alternates \
  && git update-index --index-info < sent || refuse "cannot index the objects this push sends"
awk '{ print (tolower($0) ~ /^[[:space:]]*(no-?reply@[^[:space:]]+|[^@[:space:]]+@users\.noreply\.github\.com)[[:space:]]*$/ ? "" : $0) }' \
  "$list" > private-literals.txt || refuse "cannot read private-literals.txt"
report="$(bash "$engine" --private-literals 2>&1)" \
  || { mask <<< "$report"; refuse "scripts/check-public-core.sh --private-literals failed (objects named above)"; }
