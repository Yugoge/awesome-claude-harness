def code_defaults(home, rev):
    """[(env name, value)] of the built-in defaults the previous revision's code carried."""
    texts, found = {}, []
    for name, path, extract in CODE_DEFAULTS:
        if path not in texts:
            data = blob(home, "%s:%s" % (rev, path))
            texts[path] = data.decode("utf-8", "replace") if data is not None else ""
        value = extract(texts[path], name)
        if value:
            found.append((name, value))
    return found


def module_enabled(fragment, prev, base):
    """A module is on when prev carries one of its contributions that the base lacks: a hook
    command (compared normalised), a matcher alternative on a hook the base already runs, or a
    permission entry."""
    p_perms, b_perms = _d(prev.get("permissions")), _d(base.get("permissions"))
    for name, entries in fragment.get("permissions", {}).items():
        p_lst = p_perms.get(name) if isinstance(p_perms.get(name), list) else []
        b_lst = b_perms.get(name) if isinstance(b_perms.get(name), list) else []
        if any(e in p_lst and e not in b_lst for e in entries):
            return True
    p_hooks, b_hooks = _d(prev.get("hooks")), _d(base.get("hooks"))
    for event, groups in fragment.get("hooks", {}).items():
        b_groups = [g for g in _list(b_hooks.get(event)) if isinstance(g, dict)]
        b_keys = _hook_keys(b_groups)
        for g in groups:
            keys = {hook_key(h) for h in g["hooks"]}
            b_alts = set()
            for bg in b_groups:
                if keys & _hook_keys([bg]):
                    b_alts.update(_alts(bg.get("matcher")))
            for pg in _list(p_hooks.get(event)):
                shared = keys & _hook_keys([pg]) if isinstance(pg, dict) else set()
                if not shared:
                    continue
                if shared - b_keys:
                    return True
                p_alts = _alts(pg.get("matcher"))
                if any(a in p_alts and a not in b_alts for a in _alts(g.get("matcher"))):
                    return True
    return False


def _tracked_hook(home, rev, hook):
    m = re.search(r"@H/((?:hooks|scripts)/\S+)", norm_command(str(hook.get("command", ""))))
    proc = _git(home, "cat-file", "-e", "%s:%s" % (rev, m.group(1))) if m else None
    return proc is not None and proc.returncode == 0


def cmd_migrate(home, rev, settings_file, base_rev, previous=None):
    target = os.path.join(home, OVERLAY)
    if os.path.lexists(target):
        _err("migrate refused: %s already exists (migrate only seeds a new overlay; edit the "
             "existing one instead)" % target)
        return 1
    if not is_checkout(home):
        _err("migrate refused: %s is not a git checkout" % home)
        return 1
    for value in (rev, base_rev):
        if value is not None and (value.startswith("-") or
                                  _git_out(home, "rev-parse", "--verify", "--quiet",
                                           value + "^{commit}") is None):
            _err("migrate refused: unknown revision %r" % value)
            return 1
    if previous is not None:  # (settings, source) the landing reconstructed
        prev, source = previous
    elif settings_file:
        try:
            prev = parse(_read(settings_file))
        except OSError:
            prev = None
        source = settings_file
    else:
        prev = parse(blob(home, "%s:%s" % (rev, SETTINGS)))
        source = "%s:%s" % (rev, SETTINGS)
    if prev is None:
        _err("migrate refused: %s is missing or not a JSON object" % source)
        return 1
    specs = ["%s:%s" % (base_rev, SETTINGS)] if base_rev else [":" + SETTINGS, "HEAD:" + SETTINGS]
    base = None
    for spec in specs:
        base = parse(blob(home, spec))
        if base is not None:
            break
    if base is None:
        _err("migrate refused: no clean settings.json in %s" % " or ".join(specs))
        return 1
    modules = {name: module_enabled(MODULES[name], prev, base) for name in sorted(MODULES)}
    try:
        reference = merge_all(copy.deepcopy(base), [MODULES[n] for n in modules if modules[n]])
    except ShapeError as exc:
        _err("migrate refused: the clean settings.json has an unexpected structure at %s" % exc)
        return 1
    extra = diff(prev, reference)
    # A hook running a harness script that rev tracks was public there: missing from the clean form
    # now means upstream unregistered it (P1's retired Stop gate, an exit-0 stub until P10 deletes
    # it), so it is not personal and is not migrated.
    for groups in extra.get("hooks", {}).values():
        for g in groups:
            g["hooks"] = [h for h in g["hooks"] if not _tracked_hook(home, rev, h)]
        groups[:] = [g for g in groups if g["hooks"]]
    extra["hooks"] = {event: groups for event, groups in extra.get("hooks", {}).items() if groups}
    if not extra["hooks"]:
        del extra["hooks"]
    env = extra.pop("env", {})
    ref_env = _d(reference.get("env"))
    for name, value in code_defaults(home, rev):
        if name not in env and name not in ref_env:
            env[name] = value
    env.setdefault("CLAUDE_HOME", home)
    pushed = env.get("GIT_AUTO_PUSH") == "1"  # D1: push is opt-in, never carried into a new overlay
    if pushed:
        del env["GIT_AUTO_PUSH"]
    overlay = {"modules": modules, "env": env}
    overlay.update(extra)
    try:
        _validate_layer(_layer_of(overlay), "migrated overlay")
    except OverlayError as exc:
        _err("migrate refused: %s" % exc)
        return 1
    try:
        fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        _err("migrate refused: %s already exists" % target)
        return 1
    with os.fdopen(fd, "wb") as fh:
        fh.write(canon(overlay))
    os.chmod(target, 0o600)
    print("render-settings: wrote %s (mode 0600) from %s" % (OVERLAY, source))
    print("  modules: %s" % ", ".join("%s=%s" % (n, "on" if on else "off")
                                      for n, on in modules.items()))
    print("  env: %d keys: %s" % (len(env), ", ".join(env)))
    if pushed:
        print("  not migrated: GIT_AUTO_PUSH (automatic push is opt-in; set it in %s)" % OVERLAY)
    for name, val in overlay.get("permissions", {}).items():
        print("  permissions.%s: %s" % (name, len(val) if isinstance(val, list) else "set"))
    print("  hooks: %d groups" % sum(len(g) for g in overlay.get("hooks", {}).values()))
    others = [k for k in overlay if k not in STRUCTURED and k != "modules"]
    print("  other top-level keys: %d" % len(others))
    print("next: run scripts/bootstrap (or render-settings render) to render settings.json")
    return 0


