def _shell_default(text, name):
    m = re.search(re.escape("${%s:-" % name) + r"([^}]*)\}", text)
    return m.group(1) if m else ""


def _py_env_default(text, name):
    m = re.search(r"os\.environ\.get\(\s*[\"']%s[\"']\s*,\s*[\"']([^\"']*)[\"']\s*\)"
                  % re.escape(name), text)
    return m.group(1) if m else ""


def _hard_bans(text):
    lines, patterns = text.splitlines(), []
    for i, line in enumerate(lines):
        m = re.search(r"grep\s+-qE\s+'([^']+)'", line)
        if not m or "session_dirs" in m.group(1):
            continue
        if any("is PERMANENTLY FORBIDDEN" in later for later in lines[i + 1:i + 3]):
            if m.group(1) not in patterns:
                patterns.append(m.group(1))
    return "|".join(patterns)


def _process_family(text):
    m = re.search(re.escape(r"docker\s+(stop|restart|rm|kill)\s+.*")
                  + r"([A-Za-z0-9_][A-Za-z0-9_.-]*)", text)
    return m.group(1) if m else ""


def _extra_trailer(text):
    for line in text.splitlines():
        trailer = line.strip().rstrip("\"'").strip()
        if not trailer.startswith("Co-Authored-By:") or "$" in trailer:
            continue
        if not trailer[len("Co-Authored-By:"):].strip().lower().startswith("claude"):
            return trailer
    return ""


def _list_default(text):
    m = re.search(r"DEFAULT_ACCOUNTS\s*=\s*(\[[^\]]*\])", text)
    try:
        values = ast.literal_eval(m.group(1)) if m else []
    except (ValueError, SyntaxError):
        return ""
    return ",".join(v for v in values if isinstance(v, str) and v)


def _model_default(text):
    m = re.search(r"\"model\"\s*:\s*\"([^\"\s@]+@[^\"\s]+)\"", text)
    return m.group(1) if m else ""


SAFETY_HOOK = "hooks/pretool-bash-safety.sh"
# (env name, file in the previous revision, extractor) -- generic patterns only.
CODE_DEFAULTS = (
    ("CLAUDE_DEV_CONTAINERS", SAFETY_HOOK, _shell_default),
    ("CLAUDE_DAEMON_RESTART_GRANT_HELPER", SAFETY_HOOK, _shell_default),
    ("CLAUDE_PROTECTED_DAEMON_PREFIX", SAFETY_HOOK, _shell_default),
    ("CLAUDE_PROTECTED_DAEMON_TARGETS", SAFETY_HOOK, _shell_default),
    ("CLAUDE_RESTART_ACCOUNTS_ROOT", "hooks/lib/subagent_restart.py", _py_env_default),
    ("WORKFLOW_PRUNE_ACCOUNTS_DIR", "scripts/prune-orphaned-workflow-bookmarks.sh",
     _shell_default),
    ("WORKFLOW_PRUNE_PROJECT_DIRNAME", "scripts/prune-orphaned-workflow-bookmarks.sh",
     _shell_default),
    ("CLAUDE_HARD_BANNED_SCRIPTS", SAFETY_HOOK, lambda text, _name: _hard_bans(text)),
    ("CLAUDE_PROTECTED_PROCESS_FAMILY", SAFETY_HOOK, lambda text, _name: _process_family(text)),
    ("CLAUDE_CHECKPOINT_EXTRA_TRAILER", "hooks/lib/checkpoint-core.sh",
     lambda text, _name: _extra_trailer(text)),
    ("PASEO_DAEMON_ACCOUNTS", "scripts/paseo-daemon-ledger.py",
     lambda text, _name: _list_default(text)),
    ("PASEO_DAEMON_MODEL", "scripts/paseo-daemon-timers.py",
     lambda text, _name: _model_default(text)),
)


def code_defaults(home, rev):
    """[(env name, value)] of the built-in defaults the previous revision's code carried."""
    texts, found = {}, []
    for name, path, extract in CODE_DEFAULTS:
        if path not in texts:
            data = blob(home, "%s:%s" % (rev, path))
            texts[path] = data.decode("utf-8", "replace") if data is not None else ""
        value = extract(texts[path], name)
        if value:
            found.append((name, value))
    return found


def module_enabled(fragment, prev, base):
    """A module is on when prev carries one of its contributions that the base lacks: a hook
    command (compared normalised), a matcher alternative on a hook the base already runs, or a
    permission entry."""
    p_perms, b_perms = _d(prev.get("permissions")), _d(base.get("permissions"))
    for name, entries in fragment.get("permissions", {}).items():
        p_lst = p_perms.get(name) if isinstance(p_perms.get(name), list) else []
        b_lst = b_perms.get(name) if isinstance(b_perms.get(name), list) else []
        if any(e in p_lst and e not in b_lst for e in entries):
            return True
    p_hooks, b_hooks = _d(prev.get("hooks")), _d(base.get("hooks"))
    for event, groups in fragment.get("hooks", {}).items():
        b_groups = [g for g in _list(b_hooks.get(event)) if isinstance(g, dict)]
        b_keys = _hook_keys(b_groups)
        for g in groups:
            keys = {hook_key(h) for h in g["hooks"]}
            b_alts = set()
            for bg in b_groups:
                if keys & _hook_keys([bg]):
                    b_alts.update(_alts(bg.get("matcher")))
            for pg in _list(p_hooks.get(event)):
                shared = keys & _hook_keys([pg]) if isinstance(pg, dict) else set()
                if not shared:
                    continue
                if shared - b_keys:
                    return True
                p_alts = _alts(pg.get("matcher"))
                if any(a in p_alts and a not in b_alts for a in _alts(g.get("matcher"))):
                    return True
    return False


def cmd_migrate(home, rev, settings_file, base_rev):
    target = os.path.join(home, OVERLAY)
    if os.path.lexists(target):
        _err("migrate refused: %s already exists (migrate only seeds a new overlay; edit the "
             "existing one instead)" % target)
        return 1
    if not is_checkout(home):
        _err("migrate refused: %s is not a git checkout" % home)
        return 1
    for value in (rev, base_rev):
        if value is not None and (value.startswith("-") or
                                  _git_out(home, "rev-parse", "--verify", "--quiet",
                                           value + "^{commit}") is None):
            _err("migrate refused: unknown revision %r" % value)
            return 1
    if settings_file:
        try:
            prev = parse(_read(settings_file))
        except OSError:
            prev = None
        source = settings_file
    else:
        prev = parse(blob(home, "%s:%s" % (rev, SETTINGS)))
        source = "%s:%s" % (rev, SETTINGS)
    if prev is None:
        _err("migrate refused: %s is missing or not a JSON object" % source)
        return 1
    specs = ["%s:%s" % (base_rev, SETTINGS)] if base_rev else [":" + SETTINGS, "HEAD:" + SETTINGS]
    base = None
    for spec in specs:
        base = parse(blob(home, spec))
        if base is not None:
            break
    if base is None:
        _err("migrate refused: no clean settings.json in %s" % " or ".join(specs))
        return 1
    modules = {name: module_enabled(MODULES[name], prev, base) for name in sorted(MODULES)}
    try:
        reference = merge_all(copy.deepcopy(base), [MODULES[n] for n in modules if modules[n]])
    except ShapeError as exc:
        _err("migrate refused: the clean settings.json has an unexpected structure at %s" % exc)
        return 1
    extra = diff(prev, reference)
    env = extra.pop("env", {})
    ref_env = _d(reference.get("env"))
    for name, value in code_defaults(home, rev):
        if name not in env and name not in ref_env:
            env[name] = value
    env.setdefault("CLAUDE_HOME", home)
    overlay = {"modules": modules, "env": env}
    overlay.update(extra)
    try:
        _validate_layer(_layer_of(overlay), "migrated overlay")
    except OverlayError as exc:
        _err("migrate refused: %s" % exc)
        return 1
    try:
        fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        _err("migrate refused: %s already exists" % target)
        return 1
    with os.fdopen(fd, "wb") as fh:
        fh.write(canon(overlay))
    os.chmod(target, 0o600)
    print("render-settings: wrote %s (mode 0600) from %s" % (OVERLAY, source))
    print("  modules: %s" % ", ".join("%s=%s" % (n, "on" if on else "off")
                                      for n, on in modules.items()))
    print("  env: %d keys: %s" % (len(env), ", ".join(env)))
    for name, val in overlay.get("permissions", {}).items():
        print("  permissions.%s: %s" % (name, len(val) if isinstance(val, list) else "set"))
    print("  hooks: %d groups" % sum(len(g) for g in overlay.get("hooks", {}).values()))
    others = [k for k in overlay if k not in STRUCTURED and k != "modules"]
    print("  other top-level keys: %d" % len(others))
    print("next: run scripts/bootstrap (or render-settings render) to render settings.json")
    return 0


# -------------------------------------------------------------------------------------- main

def main(argv=None):
    parser = argparse.ArgumentParser(prog="render-settings", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("clean", help="git clean filter (stdin -> stdout)")
    sub.add_parser("smudge", help="git smudge filter (stdin -> stdout)")
    p_render = sub.add_parser("render", help="write the machine form of settings.json")
    p_render.add_argument("--force", action="store_true",
                          help="drop working-file entries the overlay does not explain")
    p_check = sub.add_parser("check", help="doctor checks, or --staged pre-commit check")
    p_check.add_argument("--staged", action="store_true",
                         help="refuse a staged settings.json in machine form")
    p_migrate = sub.add_parser("migrate", help="seed a new overlay from previous settings")
    p_migrate.add_argument("--from", dest="rev", required=True, metavar="REV")
    p_migrate.add_argument("--settings-file", metavar="PATH")
    p_migrate.add_argument("--base", dest="base_rev", metavar="REV")
    args = parser.parse_args(argv)
    home = harness_home()
    if args.command == "clean":
        return cmd_clean(home)
    if args.command == "smudge":
        return cmd_smudge(home)
    if args.command == "render":
        return cmd_render(home, args.force)
    if args.command == "check":
        return cmd_check_staged(home) if args.staged else cmd_check(home)
    return cmd_migrate(home, args.rev, args.settings_file, args.base_rev)


if __name__ == "__main__":
    sys.exit(main())
