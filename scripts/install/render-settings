_VAR = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)(?::-([^}]*))?\}|\$([A-Za-z_][A-Za-z0-9_]*)")


def expand(word, env, depth=0):
    """Expand ${VAR:-default}, ${VAR} and $VAR (and a leading ~/) like sh would."""
    if word.startswith("~/"):
        word = "$HOME" + word[1:]

    def sub(m):
        name = m.group(1) or m.group(3)
        value = env.get(name, "")
        if m.group(1) and m.group(2) is not None and not value:
            return expand(m.group(2), env, depth + 1) if depth < 8 else m.group(2)
        return value
    return _VAR.sub(sub, word)


def _ok(label, ok):
    print("[%s] %s" % (" ok " if ok else "FAIL", label))
    return ok


def check_hook_paths(home, working, overlay):
    env = dict(os.environ)
    env.update({k: v for k, v in _d(working.get("env")).items() if isinstance(v, str)})
    # Only a command of the clean form or of a module is echoed; any other may be personal.
    docs = [parse(clean_source(home)) or {}] + list(MODULES.values())
    public = _hook_keys([g for d in docs for gs in _d(d.get("hooks")).values() for g in _list(gs)])
    public -= _hook_keys([g for gs in _d(_layer_of(overlay or {}).get("hooks")).values()
                          for g in gs])
    root = os.path.realpath(home)
    total, missing = 0, []
    for event, groups in _d(working.get("hooks")).items():
        for g in groups if isinstance(groups, list) else []:
            for h in g.get("hooks", []) if isinstance(g, dict) else []:
                if not isinstance(h, dict) or h.get("type") != "command":
                    continue
                total += 1
                try:
                    words = shlex.split(str(h.get("command", "")))
                except ValueError:
                    words = []
                real = os.path.realpath(expand(words[1], env)) if len(words) > 1 else ""
                inside = bool(real) and real.startswith(root + os.sep)
                if inside and os.path.isfile(real):
                    continue
                if hook_key(h) not in public:
                    missing.append("%s: a hook outside the clean form (see %s)" % (event, OVERLAY))
                elif not real:
                    missing.append("%s: no script path in the command" % event)
                elif inside:
                    missing.append(os.path.relpath(real, root))
                else:
                    missing.append("outside the harness home: %s" % words[1])
    ok = _ok("hook paths: %d commands, missing=%d" % (total, len(missing)), not missing)
    for item in missing:
        print("       %s" % item)
    return ok


def check_filter(home, overlay_error, overlay, recorded, working):
    if overlay_error:
        return _ok("settings filter: %s" % overlay_error, False)
    if not is_checkout(home):
        return _ok("settings filter: not a git checkout: no settings filter to check", True)
    problems = []
    attr = _git_out(home, "check-attr", "filter", "--", SETTINGS) or ""
    if not attr.endswith(": " + FILTER_NAME):
        problems.append(".gitattributes does not assign filter=%s to settings.json" % FILTER_NAME)
    for key in ("clean", "smudge"):
        if not _git_out(home, "config", "--get", "filter.%s.%s" % (FILTER_NAME, key)):
            problems.append("filter.%s.%s is not set" % (FILTER_NAME, key))
    if _git_out(home, "config", "--bool", "--get", "filter.%s.required" % FILTER_NAME) != "true":
        problems.append("filter.%s.required is not true" % FILTER_NAME)
    layers = layers_of(overlay)
    index = blob(home, ":" + SETTINGS)
    if index is None:
        problems.append("settings.json is not in the index")
    else:
        smudged, problem = smudge_bytes(index, layers)
        cleaned, problem2 = clean_bytes(smudged, layers + recorded, load_base(home))
        if problem or problem2 or cleaned != index:
            problems.append("round trip clean(smudge(index)) does not reproduce the index blob")
    path = record_path(home)
    if overlay is not None and path and not os.path.exists(path):
        problems.append("no record of what render applied (%s)" % RECORD)
    if problems:
        _ok("settings filter: %s; run scripts/bootstrap" % "; ".join(problems), False)
        return False
    _ok("settings filter: registered, required, exact round trip", True)
    if working is None:
        return True
    target, layers, problem = machine_form(home, overlay, working)
    extras = working_extras(working, target, layers) if target is not None else {}
    ok = _ok("settings.json entries: %s the clean form, the enabled modules and the overlay"
             % ("some are outside" if extras else "all explained by"), not extras)
    for line in describe(extras):
        print("       %s" % line)
    if extras:
        print("       stage public edits (git add settings.json), or move them into %s to keep "
              "them; render-settings render then drops entries removed from the overlay "
              "(--force drops all the rest)" % OVERLAY)
    for key in CLI_OWNED:
        if overlay and key in overlay and key in working and working[key] != overlay[key]:
            print("[info] %s: the CLI changed it (differs from settings.machine.json); copy it "
                  "into the overlay to keep it" % key)
    return ok


def _load_module(path, name):
    directory = os.path.dirname(path)
    sys.path.insert(0, directory)
    try:
        spec = importlib.util.spec_from_file_location(name, path)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return module
    finally:
        sys.path.remove(directory)


def check_protected_runtime(home):
    try:
        config = _load_module(os.path.join(home, "hooks", "lib", "runtime_guard", "config.py"),
                              "_render_settings_runtime_guard_config")
        loaded = config._load_config()
        data_path, required = config.DATA_FILE_PATH, config.REQUIRED_KEYS
    except Exception:  # any import or load failure is a failed check, never a crash
        return _ok("protected-runtime file: cannot load hooks/lib/runtime_guard/config.py", False)
    if isinstance(loaded, dict):
        return _ok("protected-runtime file: valid", True)
    if os.environ.get("CLAUDE_PROTECTED_RUNTIME_FILE"):
        shown = "$CLAUDE_PROTECTED_RUNTIME_FILE"
    else:
        user_home = os.path.expanduser("~").rstrip("/")
        shown = "~" + data_path[len(user_home):] if data_path.startswith(user_home + "/") \
            else data_path
    return _ok("protected-runtime file: missing or incomplete at %s (needs schema_version 1 and "
               "%d required lists); run scripts/bootstrap" % (shown, len(required)), False)


def cmd_check(home):
    overlay, recorded, overlay_error = None, [], None
    try:
        overlay = load_overlay(home)
        recorded = load_record(home)
    except OverlayError as exc:
        overlay_error = str(exc)
    working = parse(_read(os.path.join(home, SETTINGS)))
    if working is None:
        hooks_ok = _ok("hook paths: settings.json is missing or not a JSON object; run "
                       "scripts/bootstrap", False)
    else:
        hooks_ok = check_hook_paths(home, working, overlay)
    filter_ok = check_filter(home, overlay_error, overlay, recorded, working)
    runtime_ok = check_protected_runtime(home)
    return 0 if hooks_ok and filter_ok and runtime_ok else 1


def cmd_check_staged(home):
    if not is_checkout(home):
        _err("check --staged: %s is not a git checkout" % home)
        return 1
    staged = blob(home, ":" + SETTINGS)
    if staged is None:
        return 0
    try:
        layers = layers_of(load_overlay(home)) + load_record(home)
    except OverlayError as exc:
        _err("check --staged: %s; fix it before committing" % exc)
        return 1
    out, problem = clean_bytes(staged, layers, load_base(home))
    if problem is None and out == staged:
        return 0
    _err(STAGED_MSG)
    return 1


