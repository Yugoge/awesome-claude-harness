#!/usr/bin/env python3
"""Settings tool for a harness home H: the checkout that holds this script (two levels above
scripts/install/).

settings.json is tracked in its clean form (public, no machine values). This machine's values
live in the untracked overlay <H>/settings.machine.json; the working settings.json is the machine
form = smudge(clean form). The git filter "claude-settings" (registered by scripts/bootstrap)
keeps the two apart, so machine values and CLI-owned keys never reach the index.

  clean              git clean filter, stdin -> stdout: removes what the enabled modules and the
                     overlay contribute, what the record lists and the CLI-owned keys, restoring
                     the values HEAD tracks.
  smudge             git smudge filter, stdin -> stdout: applies the modules, then the overlay.
                     Fail safe: invalid input or overlay passes the input through unchanged.
  render [--force]   write the machine form of <H>/settings.json; refuses (without --force) to
                     drop working-file entries that neither the clean form, the overlay nor the
                     record explains.
  check [--staged]   doctor checks (hook paths, filter wiring and round trip, entries nothing
                     explains, protected-runtime file); with --staged: refuse a staged settings.json
                     that is in machine form.
  migrate --from REV [--settings-file PATH] [--base REV]
                     seed a NEW overlay from previous personal settings (one-time owner step).

The record <git dir>/claude-settings.applied (mode 0600, never tracked) lists the layers smudge and
render applied to the working file since the last render, so that an entry dropped from the overlay
(or a deleted overlay) without a re-render is still stripped by clean and refused by check --staged.
Messages name key paths and counts only, never a settings value.

Overlay format: any settings keys (env, permissions.allow|deny|ask, hooks, other top-level keys)
plus meta keys that are never rendered: "modules" (name -> true/false) and any top-level key that
starts with "_". Exit codes: 0 success, 1 failure, 2 usage error. Python 3.10+, stdlib only.
"""
import argparse
import ast
import copy
import importlib.util
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True  # check imports harness modules; leave no caches in the checkout

FILTER_NAME = "claude-settings"
SETTINGS = "settings.json"
OVERLAY = "settings.machine.json"
RECORD = "claude-settings.applied"  # in the git directory: the layers smudge and render applied
# Keys Claude Code itself writes into user settings (/model, /config, /effort, /fast).
CLI_OWNED = ("model", "alwaysThinkingEnabled", "effortLevel", "tui", "theme",
             "autoCompactEnabled", "modelSettings", "fastMode", "advisorModel")
STRUCTURED = ("env", "permissions", "hooks")
PERMISSION_LISTS = ("allow", "deny", "ask")


def _hook(script, timeout=None):
    entry = {"type": "command",
             "command": 'python3 "${CLAUDE_HOME:-$HOME/.claude}/hooks/%s"' % script}
    if timeout is not None:
        entry["timeout"] = timeout
    return entry


# Optional modules, switched on by the overlay's "modules" key. Embedded so that the script is
# self-contained (it may run from a fetched copy).
MODULES = {
    "paseo": {
        "permissions": {"allow": ["mcp__paseo__*", "Bash(node scripts/paseo-usage-read.mjs:*)"]},
        "hooks": {
            "UserPromptSubmit": [{"hooks": [_hook("userprompt-usage-snapshot.py", 10)]}],
            "PreToolUse": [{"matcher": "mcp__paseo__browser_run_code",
                            "hooks": [_hook("pretool-runcode-watchdog.py")]}],
            "PostToolUse": [{"matcher": "mcp__paseo__browser_run_code",
                             "hooks": [_hook("posttool-runcode-watchdog.py")]}],
        },
    },
}

STAGED_MSG = ("settings.json is staged in machine form (it carries overlay values or CLI-owned "
              "keys, or is not canonical); register the filter with scripts/bootstrap and "
              "re-stage.")
KEEP_HINT = "move it into settings.machine.json to keep it"


class OverlayError(Exception):
    """The overlay exists but cannot be used."""


class ShapeError(Exception):
    """A settings document has an unexpected structure."""


def harness_home():
    return os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))


def _err(msg):
    sys.stderr.write("render-settings: %s\n" % msg)


def canon(obj):
    return (json.dumps(obj, indent=2, ensure_ascii=False) + "\n").encode("utf-8")


def parse(data):
    """The JSON object in `data` (bytes), or None."""
    if data is None:
        return None
    try:
        obj = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        return None
    return obj if isinstance(obj, dict) else None


def _d(value):
    return value if isinstance(value, dict) else {}


def _list(value):
    return value if isinstance(value, list) else []


def _read(path):
    try:
        with open(path, "rb") as fh:
            return fh.read()
    except FileNotFoundError:
        return None


# ---------------------------------------------------------------------------------------- git

def _git(home, *args):
    try:
        return subprocess.run(["git", "-C", home, *args], stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE, stdin=subprocess.DEVNULL)
    except OSError:
        return None


def _git_out(home, *args):
    proc = _git(home, *args)
    if proc is None or proc.returncode != 0:
        return None
    return proc.stdout.decode("utf-8", "replace").strip()


def is_checkout(home):
    top = _git_out(home, "rev-parse", "--show-toplevel")
    return bool(top) and os.path.realpath(top) == os.path.realpath(home)


def blob(home, spec):
    proc = _git(home, "cat-file", "blob", spec)
    return proc.stdout if proc is not None and proc.returncode == 0 else None


def load_base(home):
    """Base B for clean: the HEAD blob, else the index blob, else {}."""
    if is_checkout(home):
        for spec in ("HEAD:" + SETTINGS, ":" + SETTINGS):
            data = blob(home, spec)
            if data is not None:
                return parse(data) or {}
    return {}


# ------------------------------------------------------------------------------------ overlay

def _layer_of(overlay):
    return {k: v for k, v in overlay.items() if k != "modules" and not k.startswith("_")}


def _validate_layer(layer, where):
    env = layer.get("env", {})
    if not isinstance(env, dict):
        raise OverlayError("%s: env must be an object" % where)
    for key, value in env.items():
        if not isinstance(value, str):
            raise OverlayError("%s: env.%s must be a string" % (where, key))
    perms = layer.get("permissions", {})
    if not isinstance(perms, dict):
        raise OverlayError("%s: permissions must be an object" % where)
    for name, value in perms.items():
        if name in PERMISSION_LISTS and not isinstance(value, list):
            raise OverlayError("%s: permissions.%s must be a list" % (where, name))
        if isinstance(value, list) and not all(isinstance(e, str) for e in value):
            raise OverlayError("%s: permissions.%s must list strings" % (where, name))
    hooks = layer.get("hooks", {})
    if not isinstance(hooks, dict):
        raise OverlayError("%s: hooks must be an object" % where)
    for event, groups in hooks.items():
        ok = isinstance(groups, list) and all(
            isinstance(g, dict) and isinstance(g.get("hooks"), list)
            and all(isinstance(h, dict) for h in g["hooks"])
            and isinstance(g.get("matcher", ""), str) for g in groups)
        if not ok:
            raise OverlayError("%s: hooks.%s must be a list of {matcher?, hooks: [...]} groups"
                               % (where, event))


def load_overlay(home):
    """The overlay object, None when absent; raises OverlayError when unusable."""
    path = os.path.join(home, OVERLAY)
    try:
        data = _read(path)
    except OSError as exc:
        raise OverlayError("%s: cannot read (%s)" % (path, exc.strerror))
    if data is None:
        return None
    overlay = parse(data)
    if overlay is None:
        raise OverlayError("%s is not a valid JSON object" % path)
    modules = overlay.get("modules", {})
    if not isinstance(modules, dict):
        raise OverlayError("%s: modules must be an object of name -> true/false" % path)
    for name, enabled in modules.items():
        if name not in MODULES:
            raise OverlayError("%s: unknown module %r (known: %s)"
                               % (path, name, ", ".join(sorted(MODULES))))
        if not isinstance(enabled, bool):
            raise OverlayError("%s: modules.%s must be true or false" % (path, name))
    _validate_layer(_layer_of(overlay), path)
    return overlay


def layers_of(overlay):
    """Layers in merge order: enabled modules (sorted by name), then the overlay."""
    if overlay is None:
        return []
    modules = overlay.get("modules", {})
    return [MODULES[name] for name in sorted(modules) if modules[name]] + [_layer_of(overlay)]


# ------------------------------------------------------------------------------------- record

def record_path(home):
    """Where the record lives (inside the git directory, so it is never tracked); None outside a
    git checkout, where nothing is committed."""
    rel = _git_out(home, "rev-parse", "--git-path", RECORD) if is_checkout(home) else None
    return os.path.join(home, rel) if rel else None


def load_record(home):
    """The layers smudge and render applied since the last render ([] when none are recorded);
    raises OverlayError when the record is unusable."""
    path = record_path(home)
    shown = "the record %s" % (os.path.relpath(path, home) if path else RECORD)
    try:
        data = _read(path) if path else None
    except OSError as exc:
        raise OverlayError("%s: cannot read (%s)" % (shown, exc.strerror))
    if data is None:
        return []
    layers = _d(parse(data)).get("layers")
    if not isinstance(layers, list) or not all(isinstance(layer, dict) for layer in layers):
        raise OverlayError("%s is not valid; run render-settings render --force to rewrite it"
                           % shown)
    for layer in layers:
        _validate_layer(layer, shown)
    return layers


def save_record(home, layers):
    """Write the record (owner-only); raises OSError."""
    path, data = record_path(home), canon({"layers": layers})
    if path is not None and _read(path) != data:
        _write_atomic(path, data, 0o600)


def union(*groups):
    """The distinct non-empty layers of the groups, in order."""
    out = []
    for group in groups:
        for layer in group:
            if layer and layer not in out:
                out.append(layer)
    return out


# ------------------------------------------------------------------------- merge and unmerge

def _container(parent, key, kind):
    if key not in parent:
        parent[key] = kind()
    elif not isinstance(parent[key], kind):
        raise ShapeError(key)
    return parent[key]


def _matcher(group):
    m = group.get("matcher")
    if m is not None and not isinstance(m, str):
        raise ShapeError("matcher")
    return m


def _match_all(m):
    return m is None or m in ("", "*")


def _alts(m):
    return m.split("|") if isinstance(m, str) and not _match_all(m) else []


def _find(groups, g):
    """Index of the first group whose hooks list equals g's (a match-all g pairs only with a
    match-all group), else None."""
    want_all = _match_all(_matcher(g))
    for i, t in enumerate(groups):
        if isinstance(t, dict) and t.get("hooks") == g.get("hooks"):
            if want_all and not _match_all(_matcher(t)):
                continue
            return i
    return None


def merge(y, layer):
    """Apply one layer to the settings object y in place."""
    for key, value in layer.items():
        if key == "env":
            for name, val in value.items():
                _container(y, "env", dict)[name] = copy.deepcopy(val)
        elif key == "permissions":
            for name, val in value.items():
                if isinstance(val, list):
                    for entry in val:
                        lst = _container(_container(y, "permissions", dict), name, list)
                        if entry not in lst:
                            lst.append(entry)
                else:
                    _container(y, "permissions", dict)[name] = copy.deepcopy(val)
        elif key == "hooks":
            for event, groups in value.items():
                for g in groups:
                    lst = _container(_container(y, "hooks", dict), event, list)
                    i = _find(lst, g)
                    if i is None:
                        lst.append(copy.deepcopy(g))
                        continue
                    t = lst[i]
                    if _match_all(_matcher(t)):
                        continue  # already runs for every tool
                    have = _alts(t["matcher"])
                    add = []
                    for alt in _alts(_matcher(g)):
                        if alt not in have and alt not in add:
                            add.append(alt)
                    if add:
                        t["matcher"] = "|".join([t["matcher"]] + add)
        else:
            y[key] = copy.deepcopy(value)
    return y


def merge_all(y, layers):
    for layer in layers:
        merge(y, layer)
    return y


def _restore(y, base, key):
    if key in base:
        y[key] = copy.deepcopy(base[key])
    else:
        y.pop(key, None)


def _nth_equal(groups, hooks, n):
    for g in groups:
        if isinstance(g, dict) and g.get("hooks") == hooks:
            if n == 0:
                return g
            n -= 1
    return None


def _unmerge_event(lst, layer_groups, base_groups):
    """Remove what layer_groups contributed to one event list. The k-th y group with a given
    hooks list corresponds to the k-th base group with that hooks list (merge only appends)."""
    out = []
    for pos, t in enumerate(lst):
        if not isinstance(t, dict):
            out.append(t)
            continue
        hooks = t.get("hooks")
        mine = [g for g in layer_groups if g.get("hooks") == hooks]
        if not mine:
            out.append(t)
            continue
        nth = sum(1 for u in lst[:pos] if isinstance(u, dict) and u.get("hooks") == hooks)
        bt = _nth_equal(base_groups, hooks, nth)
        added = set()
        for g in mine:
            added.update(_alts(_matcher(g)))
        m = _matcher(t)
        if bt is None:  # a group the layers appended
            if _match_all(m):
                if any(_match_all(_matcher(g)) for g in mine):
                    continue
            else:
                keep = [a for a in _alts(m) if a not in added]
                if not keep:
                    continue
                if keep != _alts(m):
                    t["matcher"] = "|".join(keep)
        elif not _match_all(m):  # the base's own group, possibly with extended matcher
            base_alts = _alts(_matcher(bt))
            cur = _alts(m)
            keep = [a for a in cur if a not in added or a in base_alts]
            if not keep:
                _restore(t, bt, "matcher")
            elif keep != cur:
                t["matcher"] = "|".join(keep)
        out.append(t)
    lst[:] = out


def unmerge_all(y, layers, base):
    """Inverse of merge_all: everything the layers own goes back to the base's value (or is
    removed when the base lacks it); CLI-owned keys likewise."""
    env_keys, perm_entries, perm_values, top_keys, hook_groups = [], {}, [], [], {}
    for layer in layers:
        for key, value in layer.items():
            if key == "env":
                env_keys.extend(value)
            elif key == "permissions":
                for name, val in value.items():
                    if isinstance(val, list):
                        perm_entries.setdefault(name, []).extend(val)
                    else:
                        perm_values.append(name)
            elif key == "hooks":
                for event, groups in value.items():
                    hook_groups.setdefault(event, []).extend(groups)
            else:
                top_keys.append(key)
    for key in top_keys:
        _restore(y, base, key)
    if env_keys and "env" in y:
        env, b_env = _container(y, "env", dict), _d(base.get("env"))
        for key in env_keys:
            _restore(env, b_env, key)
        if not env and "env" not in base:
            del y["env"]
    if (perm_entries or perm_values) and "permissions" in y:
        perms, b_perms = _container(y, "permissions", dict), _d(base.get("permissions"))
        for name, entries in perm_entries.items():
            if name in perms and name not in perm_values:
                lst = _container(perms, name, list)
                b_lst = b_perms.get(name) if isinstance(b_perms.get(name), list) else []
                lst[:] = [e for e in lst if e not in entries or e in b_lst]
                if not lst and name not in b_perms:
                    del perms[name]
        for name in perm_values:
            _restore(perms, b_perms, name)
        if not perms and "permissions" not in base:
            del y["permissions"]
    if hook_groups and "hooks" in y:
        hooks, b_hooks = _container(y, "hooks", dict), _d(base.get("hooks"))
        for event, groups in hook_groups.items():
            if event not in hooks:
                continue
            b_lst = b_hooks.get(event) if isinstance(b_hooks.get(event), list) else []
            _unmerge_event(_container(hooks, event, list), groups, b_lst)
            if not hooks[event] and event not in b_hooks:
                del hooks[event]
        if not hooks and "hooks" not in base:
            del y["hooks"]
    # Machine-only by definition: never part of the clean form, whatever HEAD holds, so a
    # committed one is caught by `check --staged` even in CI, where there is no overlay.
    for key in CLI_OWNED:
        y.pop(key, None)
    if isinstance(y.get("env"), dict):
        y["env"].pop("CLAUDE_HOME", None)
    return y


def clean_bytes(data, layers, base):
    """(output, problem): canonical clean form, or the input unchanged plus the reason."""
    y = parse(data)
    if y is None:
        return data, "input is not a JSON object"
    try:
        unmerge_all(y, layers, base)
    except ShapeError as exc:
        return data, "unexpected structure at %s" % exc
    return canon(y), None


def smudge_bytes(data, layers):
    y = parse(data)
    if y is None:
        return data, "input is not a JSON object"
    try:
        merge_all(y, layers)
    except ShapeError as exc:
        return data, "unexpected structure at %s" % exc
    return canon(y), None


# ------------------------------------------------------------------------------------- diff

_PREFIX = re.compile(r"(?<!\S)\S*?/(hooks|scripts)/")


def norm_command(cmd):
    """A hook command with quotes dropped and any path prefix before /hooks/ or /scripts/
    (absolute, ~, or the ${CLAUDE_HOME:-...} channel expression) replaced by a fixed token."""
    text = cmd.replace('"', "").replace("'", "")
    return " ".join(_PREFIX.sub(lambda m: "@H/%s/" % m.group(1), text).split())


def hook_key(hook):
    if hook.get("type") == "command" and isinstance(hook.get("command"), str):
        return "command:" + norm_command(hook["command"])
    return json.dumps(hook, sort_keys=True)


def _hook_keys(groups):
    keys = set()
    for g in groups if isinstance(groups, list) else []:
        if isinstance(g, dict) and isinstance(g.get("hooks"), list):
            keys.update(hook_key(h) for h in g["hooks"] if isinstance(h, dict))
    return keys


def diff(prev, ref, skip_env=(), skip_top=()):
    """Entries of prev not explained by ref, shaped like an overlay: env keys whose value
    differs or is missing; other top-level keys that differ or are missing; permission entries
    absent from ref; hooks of prev groups whose normalised command ref lacks (per event)."""
    out = {}
    r_env = _d(ref.get("env"))
    env = {k: copy.deepcopy(v) for k, v in _d(prev.get("env")).items()
           if k not in skip_env and (k not in r_env or r_env[k] != v)}
    if env:
        out["env"] = env
    r_perms, perms = _d(ref.get("permissions")), {}
    for name, val in _d(prev.get("permissions")).items():
        if isinstance(val, list):
            r_lst = r_perms.get(name) if isinstance(r_perms.get(name), list) else []
            add = []
            for entry in val:
                if entry not in r_lst and entry not in add:
                    add.append(entry)
            if add:
                perms[name] = add
        elif name not in r_perms or r_perms[name] != val:
            perms[name] = copy.deepcopy(val)
    if perms:
        out["permissions"] = perms
    r_hooks, hooks = _d(ref.get("hooks")), {}
    for event, groups in _d(prev.get("hooks")).items():
        known = _hook_keys(r_hooks.get(event))
        for g in groups if isinstance(groups, list) else []:
            if not (isinstance(g, dict) and isinstance(g.get("hooks"), list)):
                continue
            missing = [h for h in g["hooks"] if isinstance(h, dict) and hook_key(h) not in known]
            if missing:
                group = copy.deepcopy(g)
                group["hooks"] = copy.deepcopy(missing)
                hooks.setdefault(event, []).append(group)
    if hooks:
        out["hooks"] = hooks
    for key, value in prev.items():
        if key in STRUCTURED or key in skip_top:
            continue
        if key not in ref or ref[key] != value:
            out[key] = copy.deepcopy(value)
    return out


def _count(n, one, many):
    return "%d %s" % (n, one if n == 1 else many)


def describe(extras):
    """Key paths and counts of the extra entries: never a value, entry text or command."""
    lines = ["env.%s" % k for k in extras.get("env", {})]
    for name, val in extras.get("permissions", {}).items():
        lines.append("permissions.%s" % name + (": " + _count(len(val), "entry", "entries")
                                                 if isinstance(val, list) else ""))
    for event, groups in extras.get("hooks", {}).items():
        n = sum(len(g["hooks"]) for g in groups)
        lines.append("hooks.%s: %s" % (event, _count(n, "hook command", "hook commands")))
    lines.extend(k for k in extras if k not in STRUCTURED)
    return lines


def working_extras(working, target, layers):
    """Entries of the working file that neither the target (machine form) nor the layers explain.
    What a layer owns is explained whatever its working value (it is the layer's, possibly
    stale)."""
    owned_env = {k for layer in layers for k in layer.get("env", {})}
    owned_top = {k for layer in layers for k in layer if k not in STRUCTURED}
    ref = copy.deepcopy(target)
    try:
        merge_all(ref, layers)
    except ShapeError:  # a recorded layer that no longer fits: its entries count as extras
        ref = target
    return diff(working, ref, skip_env=owned_env, skip_top=set(CLI_OWNED) | owned_top)


# ---------------------------------------------------------------------------- clean / smudge

def cmd_clean(home):
    data = sys.stdin.buffer.read()
    try:
        layers = layers_of(load_overlay(home)) + load_record(home)
    except OverlayError as exc:
        _err("clean refused: %s; fix it, then re-stage settings.json" % exc)
        return 1
    out, problem = clean_bytes(data, layers, load_base(home))
    if problem:
        _err("clean: %s; passing settings.json through unchanged" % problem)
    sys.stdout.buffer.write(out)
    return 0


def cmd_smudge(home):
    data = sys.stdin.buffer.read()
    try:
        layers = layers_of(load_overlay(home))
        if layers:  # recorded before git writes the file: every applied value stays listed
            save_record(home, union(load_record(home), layers))
    except (OverlayError, OSError) as exc:
        _err("smudge: %s; writing the clean form unchanged" % exc)
        layers = None
    out = data
    if layers is not None:
        out, problem = smudge_bytes(data, layers)
        if problem:
            _err("smudge: %s; passing settings.json through unchanged" % problem)
    sys.stdout.buffer.write(out)
    return 0


# ------------------------------------------------------------------------------------ render

def _write_atomic(path, data, mode=None):
    if mode is None:
        try:
            mode = os.stat(path).st_mode & 0o7777
        except FileNotFoundError:
            mode = 0o644
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".settings.render.")
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def refresh_index(home):
    """Refresh the index stat cache for settings.json. git trusts a size change without running
    the clean filter, so first re-record the SAME mode and blob (clearing the cached stat); the
    refresh then compares content through the filter. The index content never changes, and an
    entry the user flagged (skip-worktree, assume-unchanged) is left alone."""
    entry = _git_out(home, "ls-files", "-s", "--", SETTINGS) or ""
    tag = _git_out(home, "ls-files", "-v", "--", SETTINGS) or ""
    if tag.startswith("H ") and len(entry.splitlines()) == 1 and "\t" in entry:
        fields = entry.split("\t", 1)[0].split()
        if len(fields) == 3 and fields[2] == "0":
            _git(home, "update-index", "--cacheinfo", "%s,%s,%s" % (fields[0], fields[1], SETTINGS))
    _git(home, "update-index", "-q", "--refresh")


def clean_source(home):
    """The clean form's bytes: the index blob, else HEAD's, else the working file."""
    source = None
    if is_checkout(home):
        source = blob(home, ":" + SETTINGS)
        if source is None:
            source = blob(home, "HEAD:" + SETTINGS)
    return source if source is not None else _read(os.path.join(home, SETTINGS))


def machine_form(home, overlay, working):
    """(target, layers, problem): the machine form of the clean form, CLI-owned keys of the
    working file carried over."""
    layers = layers_of(overlay)
    source = clean_source(home)
    if source is None:
        return None, layers, "no settings.json in the index, HEAD or the working tree"
    target = parse(source)
    if target is None:
        return None, layers, "the clean form of settings.json is not a valid JSON object"
    try:
        merge_all(target, layers)
    except ShapeError as exc:
        return None, layers, "the clean form has an unexpected structure at %s" % exc
    for key in working or {}:
        if key in CLI_OWNED:
            target[key] = copy.deepcopy(working[key])
    return target, layers, None


def cmd_render(home, force):
    try:
        overlay = load_overlay(home)
    except OverlayError as exc:
        _err("render refused: %s" % exc)
        return 1
    try:
        recorded = load_record(home)
    except OverlayError as exc:
        if not force:
            _err("render refused: %s" % exc)
            return 1
        recorded = []  # --force drops every entry the overlay does not explain
    path = os.path.join(home, SETTINGS)
    current = _read(path)
    working = parse(current)
    if current is not None and working is None and not force:
        _err("settings.json is not a valid JSON object; fix it, or re-run with --force to "
             "replace it")
        return 1
    target, layers, problem = machine_form(home, overlay, working)
    if problem:
        _err("render refused: %s" % problem)
        return 1
    if working is not None and not force:
        # Recorded entries the overlay has since dropped are explained: the render drops them.
        extras = working_extras(working, target, layers + recorded)
        if extras:
            for line in describe(extras):
                _err("extra in settings.json: %s -- %s" % (line, KEEP_HINT))
            _err("render refused: settings.json has entries outside the clean form and the "
                 "overlay (git diff settings.json shows them); move them into "
                 "settings.machine.json, or re-run with --force to drop them")
            return 1
    out = canon(target)
    changed = out != current
    index = blob(home, ":" + SETTINGS) if is_checkout(home) else None
    # An index still carrying a recorded value (staged without the filter) keeps the old record,
    # so that check --staged goes on refusing it.
    keep = recorded if index is not None and \
        clean_bytes(index, layers + recorded, load_base(home))[0] != index else []
    try:
        save_record(home, union(recorded, layers))  # covers the file before and after the write
        if changed:
            _write_atomic(path, out)
        save_record(home, union(keep, layers))
    except OSError as exc:
        _err("render failed: %s" % exc)
        return 1
    if is_checkout(home):
        refresh_index(home)
    modules = [n for n in sorted(MODULES) if overlay and overlay.get("modules", {}).get(n)]
    print("render-settings: settings.json %s (overlay: %s; modules: %s)"
          % ("rendered" if changed else "already up to date",
             "present" if overlay is not None else "absent", ", ".join(modules) or "none"))
    return 0


