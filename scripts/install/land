#!/usr/bin/env bash
# land — the landing (P7b): a harness home that ran pre-P7 code reaches by itself the state P7's
# one-time manual migration gives. hooks/auto-commit.sh runs it at every Stop: it always exits 0
# and prints at most one plain line, the session's notice; logs/landing.log gets counts, key names
# and revision ids, never a value. `--state` prints landed (overlay, record, filter registered,
# installed git hooks equal to hooks/git-hooks/), hooks (landed but a hook differs: step 5 alone
# runs again), removed (record without overlay: left to doctor), upgraded (the HEAD reflog or
# ORIG_HEAD, holds a revision before the settings filter, and does not start with a clone of a
# later one) or none (a fresh clone: left to init).
# An upgraded home lands under a lock unless a rebase or merge is stopped in it: legacy auto-push
# hooks renamed aside and stale git-fswatch daemons restarted (here and in the repositories under
# $HOME; the home's own daemon in its git work makes the landing wait), render-settings land
# (repair the index a conflicted pull left, migrate, seed the private-literal list), then init
# steps 3-5; each step is idempotent, and the whole stays under 15 s. A landed home whose later
# pull conflicted on settings.json or on doc-sync's date lines gets render-settings land --repair,
# and one with a stale daemon (left running before, or older than a later pull) restarts it; a
# settings.json that a CLI write left stat-dirty gets its index stat re-recorded (review N1).
set -u
trap 'exit 0' EXIT  # R9: exit 0 whatever fails below
case "${BASH_SOURCE[0]}" in */*) cd -P "${BASH_SOURCE[0]%/*}/../.." ;; *) cd -P ../.. ;; esac 2>/dev/null || exit 0
H="$PWD" NOTE="" LOG=logs/landing.log  # the harness home is the working directory from here on

own_hooks() {  # step 5 installs only into this repository's own hooks directory
  case "$HOOK_SCOPE" in ""|local|worktree) return 0 ;; esac
  case "$(realpath -m "$HOOKS")/" in "$(realpath -m "$COMMON")"/*) return 0 ;; esac
  return 1
}
state() {  # STATE, COMMON, HOOKS, HOOK_SCOPE: two git calls on a landed home
  local rec="" cfg f s
  STATE=none COMMON="" HOOKS="" HOOK_SCOPE=""
  { read -r rec; read -r HOOKS; read -r COMMON; } < <(git rev-parse --git-path claude-settings.applied \
    --git-path hooks --git-common-dir 2>/dev/null)
  [ -n "$COMMON" ] || return 0
  cfg="$(git config --show-scope --get-regexp '^(filter\.claude-settings\.clean|core\.hookspath)$' 2>/dev/null)"
  while read -r s f _; do [ "$f" != core.hookspath ] || HOOK_SCOPE="$s"; done <<< "$cfg"
  if [ -f settings.machine.json ] && [ -f "$rec" ] && [[ $cfg == *filter.claude-settings.clean* ]]; then
    STATE=landed
    own_hooks || return 0  # step 5 cannot install there (R4): nothing to compare
    for f in hooks/git-hooks/*; do  # the ones step 5 installs say so on their second line
      s=""; { read -r _; read -r s; } 2>/dev/null < "$f"
      [[ $s == "# claude-harness "*" (installed by scripts/bootstrap)" ]] || continue
      cmp -s "$f" "$HOOKS/${f##*/}" || { STATE=hooks; return 0; }
    done
  elif [ -f "$rec" ] && [ ! -e settings.machine.json ] && [ ! -L settings.machine.json ]; then
    STATE=removed
  elif python3 scripts/install/render-settings land --rev >/dev/null 2>&1; then
    STATE=upgraded
  fi
}
log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$LOG" 2>/dev/null; }
finish() {  # <log result> <notice>: the one notice line (no quote or backslash), exit 0
  log "result=$1 head=$(git rev-parse --short=12 HEAD 2>/dev/null)"
  [ -z "$2" ] || printf '%s\n' "$2" | tr -d '"\\'
  exit 0
}

legacy_hooks() {  # R6: renamed aside (reversible); LFS hooks restored where the hook carried them
  local g repo dir f to t n=0 lfs=0 kept="" found="" rc=0 i=0
  # The repositories under $HOME (owner input "also"): a scan cut at 5 s for R1's bound, and said so;
  # past 8 s the loop leaves the ones after the home's own (the first) as well (review RQ-4).
  [ -z "${HOME:-}" ] || { found="$(timeout 5 find "$HOME" -maxdepth 5 -type d -name .git -prune 2>/dev/null)"; rc=$?; }
  while IFS= read -r g; do
    [ $((i++)) -eq 0 ] || [ "$SECONDS" -lt 8 ] || { rc=124; break; }
    repo="${g%/*}"
    dir="$(git -C "$repo" config --get core.hooksPath 2>/dev/null)" && dir="$(cd "$repo" && realpath -m "${dir/#\~/${HOME:-~}}")"
    for f in "$g/hooks/post-commit" "$g/keystone-hooks/preserved/post-commit" ${dir:+"$dir/post-commit"}; do
      [ -f "$f" ] && grep -q 'GIT_AUTO_PUSH:-1' "$f" 2>/dev/null || continue
      # One the repository tracks (a shared .githooks/) stays: renamed, its next commit -a deletes it.
      git -C "$repo" --literal-pathspecs ls-files --error-unmatch -- "$f" >/dev/null 2>&1 \
        && { kept=$((kept + 1)); continue; }
      to="$f.auto-push-disabled"; [ ! -e "$to" ] || to="$to.$(date +%s)"
      mv -f "$f" "$to" 2>/dev/null || continue
      n=$((n + 1))
      grep -q 'git lfs' "$to" && command -v git-lfs >/dev/null 2>&1 && t="$(mktemp -d 2>/dev/null)" || continue
      # It carried the LFS step: git-lfs's own post-commit, written to a scratch hooks dir, takes its
      # place; `git lfs update --force` would overwrite the repository's other hooks.
      git -C "$repo" -c core.hooksPath="$t" lfs update >/dev/null 2>&1 && cp "$t/post-commit" "$f" 2>/dev/null \
        && lfs=$((lfs + 1))
      rm -rf "$t"
    done
  done < <(printf '%s\n' "$COMMON" "$found" | while IFS= read -r g; do [ -z "$g" ] || realpath -e "$g" 2>/dev/null; done | awk '!seen[$0]++')
  [ "$rc" -eq 124 ] && rc=" scan=timed-out" || rc=""
  log "legacy-hooks disabled=$n lfs-restored=$lfs${kept:+ tracked-left=$kept}$rc"
  [ "$n" -eq 0 ] || NOTE="$NOTE; $n legacy auto-push hook(s) renamed aside"
  [ "$lfs" -eq 0 ] || NOTE="$NOTE (LFS hooks restored in $lfs)"
  [ -z "$kept" ] || NOTE="$NOTE; $kept tracked legacy auto-push hook(s) left as they are"
  [ -z "$rc" ] || NOTE="$NOTE; the scan for other repositories under ~ stopped at its time limit; those it did not reach keep their legacy hooks"
}

# R8's candidates: bash processes running a git-fswatch.sh (argv[1]) that started at or before
# this home's current daemon code, in STALE. One builtin read per /proc/<pid>/cmdline and no
# process started unless one runs such a script: a landed home checks this at every Stop.
stale() {
  local f a b k v up now boot tick newest=0 line
  local -a st
  STALE=()
  for f in /proc/[0-9]*/cmdline; do  # a zombie's cmdline is empty
    { IFS= read -r -d '' a && IFS= read -r -d '' b; } 2>/dev/null < "$f" || continue
    case "${a##*/}:$b" in bash:*git-fswatch.sh|sh:*git-fswatch.sh) f="${f#/proc/}"; STALE+=("${f%/cmdline}") ;; esac
  done
  [ "${#STALE[@]}" -gt 0 ] || return 1
  # In centiseconds (review LH-4: /proc/stat's btime has whole seconds): the daemon code's newest
  # mtime, and the boot time as the clock now minus /proc/uptime.
  while read -r k _ v _; do [[ $v == *.* ]] && v="${v#*.}00" || v=00
    v=$((k * 100 + 10#${v:0:2})); [ "$v" -le "$newest" ] || newest=$v
  done < <(stat -c '%Y %y' hooks/git-fswatch.sh hooks/lib/checkpoint-core.sh 2>/dev/null)
  read -r up _ < /proc/uptime; up="${up//[!0-9]/}"; now="${EPOCHREALTIME//[!0-9]/}"
  [ -n "$now" ] || now="$(date +%s%6N)"; tick="$(getconf CLK_TCK 2>/dev/null)"
  boot=$(( ${now:-0} / 10000 - 10#${up:-0} ))
  [ "$newest" -gt 0 ] && [ "${up:-0}" -gt 0 ] && [ -n "$tick" ] || { STALE=(); return 1; }
  for k in "${!STALE[@]}"; do
    line=""; read -r line 2>/dev/null < "/proc/${STALE[k]}/stat"; read -r -a st <<< "${line##*) }"
    [ "${#st[@]}" -ge 20 ] && [ $((boot + st[19] * 100 / tick)) -le "$newest" ] || unset 'STALE[k]'
  done
  [ "${#STALE[@]}" -gt 0 ]
}
_tree() { local c; for c in $(pgrep -P "$1" 2>/dev/null); do _tree "$c"; done; echo "$1"; }
restart_daemons() {  # [landed] R8: the stale processes running this home's git-fswatch.sh
  local pid st now watch gd unit n=0 busy=0 home=0 stopped=0 later=0 failed=0 c e k
  local -a argv envv
  printf -v now '%(%s)T' -1
  stale || :
  for pid in "${STALE[@]}"; do
    mapfile -d '' -t argv 2>/dev/null < "/proc/$pid/cmdline" && [ "${#argv[@]}" -ge 2 ] || continue  # a zombie has none
    watch="$(readlink "/proc/$pid/cwd" 2>/dev/null)" || continue  # its main() cd's to the watched path
    case "${argv[1]:-}" in /*) c="${argv[1]}" ;; *) c="$watch/${argv[1]:-}" ;; esac
    [ "$(realpath -e "$c" 2>/dev/null)" = "$H/hooks/git-fswatch.sh" ] || continue
    st="$(cat "/proc/$pid/stat" 2>/dev/null)" || continue; read -r -a st <<< "${st##*) }"; [ "${#st[@]}" -ge 20 ] || continue
    cmp -s "/proc/$pid/cmdline" "/proc/${st[1]}/cmdline" 2>/dev/null && continue  # one of its subshells
    gd="$(git -C "$watch" rev-parse --absolute-git-dir 2>/dev/null)" || continue  # its repository is gone
    # In its git work: a git child, or a git lock younger than a minute (one a git that is gone
    # left behind is no work). Only the harness home's own daemon holds the landing.
    k=""; for c in $(_tree "$pid"); do [ "$(cat "/proc/$c/comm" 2>/dev/null)" != git ] || k=busy; done
    [ -e "$gd/index.lock" ] && [ $((now - $(stat -c %Y "$gd/index.lock" 2>/dev/null || echo 0))) -lt 60 ] && k=busy
    if [ -n "$k" ]; then if [ "$watch" = "$H" ]; then home=1; else busy=$((busy + 1)); fi; continue; fi
    # A rebase or merge stopped in its repository (another one: the harness home's own was caught
    # before any step): left alone, and it does not hold the landing.
    if [ -e "$gd/rebase-merge" ] || [ -e "$gd/rebase-apply" ] || [ -e "$gd/MERGE_HEAD" ]; then stopped=$((stopped + 1)); continue; fi
    # R1's 15 s bound: a restart (up to 4.2 s) starts only while the landing is under 8 s; the
    # rest are tried again at the next turn end.
    [ "$SECONDS" -lt 8 ] || { later=$((later + 1)); continue; }
    unit="$(grep -o 'git-fswatch@[^/]*\.service' "/proc/$pid/cgroup" 2>/dev/null | head -n1)"
    if [ -n "$unit" ]; then
      if grep -qs '/user@' "/proc/$pid/cgroup"; then systemctl --user restart "$unit"; else systemctl restart "$unit"; fi >/dev/null 2>&1 \
        && n=$((n + 1)) || failed=$((failed + 1))
      continue
    fi
    mapfile -d '' -t envv 2>/dev/null < "/proc/$pid/environ" || { failed=$((failed + 1)); continue; }
    # D1, R7: one that a session started before the landing (a Claude Code variable, no
    # CLAUDE_HOME) does not keep that session's stale GIT_AUTO_PUSH.
    k=0; for e in "${envv[@]}"; do case "$e" in CLAUDECODE=*|CLAUDE_PROJECT_DIR=*) k=$((k | 1)) ;; CLAUDE_HOME=*) k=$((k | 2)) ;; esac; done
    [ "$k" -ne 1 ] || for e in "${!envv[@]}"; do [[ ${envv[e]} != GIT_AUTO_PUSH=* ]] || unset 'envv[e]'; done
    kill -TERM $(_tree "$pid") 2>/dev/null
    for _ in $(seq 30); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
    kill -0 "$pid" 2>/dev/null && kill -KILL $(_tree "$pid") 2>/dev/null && sleep 0.2
    # Its own environment, never this session's; detached, and without the landing lock (fd 9).
    env -i -C "$watch" "${envv[@]}" setsid "${argv[0]}" "$H/hooks/git-fswatch.sh" "$watch" \
      </dev/null >/dev/null 2>&1 9>&- &
    c=$!; sleep 1
    if kill -0 "$c" 2>/dev/null; then n=$((n + 1)); else failed=$((failed + 1)); fi
  done
  # A landed home tries the ones left running again at every Stop: it says only what it did.
  [ "${1:-}" = landed ] && [ $((n + failed)) -eq 0 ] && return 0
  log "fswatch restarted=$n busy=$busy busy-home=$home stopped-integration=$stopped later=$later failed=$failed"
  [ "$n" -eq 0 ] || NOTE="$NOTE; $n stale git-fswatch daemon(s) restarted"
  [ "$failed" -eq 0 ] || NOTE="$NOTE; $failed git-fswatch restart(s) failed"
  [ "$later" -eq 0 ] || NOTE="$NOTE; $later stale git-fswatch daemon(s) left for a later turn end: the landing's time budget is used"
  [ "${1:-}" != landed ] || return 0
  [ "$busy" -eq 0 ] || NOTE="$NOTE; $busy stale git-fswatch daemon(s) left running: in the middle of their git work"
  [ "$stopped" -eq 0 ] || NOTE="$NOTE; $stopped stale git-fswatch daemon(s) left running: a rebase or merge is stopped in its repository"
  [ $((busy + stopped)) -eq 0 ] || NOTE="$NOTE (tried again at later turn ends)"
  [ "$home" -eq 0 ]
}

state
[ "${1:-}" = "--state" ] && { echo "$STATE"; exit 0; }
case "$STATE" in landed|hooks|upgraded) ;; *) exit 0 ;; esac
if [ "$STATE" = landed ]; then  # a later pull's conflicted stash pop (its entry is kept), or a stale daemon
  # settings.json unmerged, or an index or CLAUDE.md whose stash change is doc-sync's date lines
  # only (review LH-5: the owner's own conflict there is not the repair's, so no run per Stop).
  REPAIR="" p0=""
  [ -s "$COMMON/logs/refs/stash" ] && while IFS=$'\t' read -r _ p; do
    [ "$p" != "$p0" ] && p0="$p" || continue
    case "$p" in settings.json) REPAIR=1 ;; INDEX.md|*/INDEX.md|CLAUDE.md|*/CLAUDE.md)
      d="$(git diff -U0 --output-indicator-old='<' --output-indicator-new='>' refs/stash^1 \
        refs/stash -- "$p" 2>/dev/null | grep '^[<>]')"
      [ -n "$d" ] && ! grep -qvE '^[<>](\*Last updated: [^*]*\*|> Last updated: .*)$' <<< "$d" \
        && REPAIR=1 ;; esac
  done < <(git ls-files -u 2>/dev/null)
  # Review N1: a CLI write of a key the clean form leaves out (model) changes settings.json's size,
  # which git trusts without the filter, so `git pull --rebase` refused. As render's refresh_index,
  # while the content through the filter is unchanged: the same mode and blob again, then a refresh.
  # A real change is left as it is, and diffed once per write (the marker takes the file's mtime).
  re=$'^H ([0-7]+) ([0-9a-f]+) 0\tsettings\\.json$' ck="$COMMON/claude-settings.checked"
  if ! git diff-files --quiet -- settings.json && [ settings.json -nt "$ck" ]; then
    if git diff --quiet -- settings.json && [[ $(git ls-files -s -v -- settings.json) =~ $re ]]; then
      git update-index --cacheinfo "${BASH_REMATCH[1]},${BASH_REMATCH[2]},settings.json" \
        && git update-index -q --refresh
    else touch -r settings.json "$ck"; fi
  fi >/dev/null 2>&1
  [ -n "$REPAIR" ] || stale || exit 0
fi
mkdir -p logs 2>/dev/null
exec 9>>"$COMMON/claude-landing.lock" || exit 0
if ! { flock -n 9 || python3 -c 'import fcntl; fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)'; } 2>/dev/null; then
  log "result=skipped lock=taken state=$STATE"
  [ "$STATE" = upgraded ] && echo "Harness landing: another session is landing this home right now; nothing done here."
  exit 0
fi
FIRST="$STATE"; state  # again, under the lock: another session may have landed it meanwhile
[ "$STATE" = "$FIRST" ] || finish "found-$STATE" ""
[ "$STATE" != landed ] || restart_daemons landed  # R8: left running before, or stale after a later pull
GD="$(git rev-parse --absolute-git-dir 2>/dev/null)"
for op in rebase-merge:rebase rebase-apply:rebase MERGE_HEAD:merge CHERRY_PICK_HEAD:cherry-pick REVERT_HEAD:revert \
  "SQUASH_MSG:squash merge"; do  # (git merge --squash stops without a MERGE_HEAD)
  [ -e "$GD/${op%%:*}" ] || continue  # R2 S4: a stopped integration holds the owner's commits
  [ "$STATE" != landed ] || [ -n "$REPAIR" ] || break
  n="$(git ls-files -u | cut -f2 | sort -u | wc -l)"
  log "state=$STATE stopped=${op#*:} conflicted=$n"
  [ "$STATE" = upgraded ] || finish "waits-${op#*:}" "${NOTE:+Harness landing: ${NOTE#; }.}"
  finish "waits-${op#*:}" "Harness landing waits: a ${op#*:} is stopped in the harness home ($n conflicted path(s)); nothing was changed. Once it is finished or aborted, the landing runs at the next turn end."
done

settings() { out="$(python3 scripts/install/render-settings land "$@" 2>>"$LOG")"; }  # the notice part, or the failed step
if [ "$STATE" = landed ]; then
  [ -z "$REPAIR" ] || { settings --repair; NOTE="${out:+; $out}$NOTE"; }
  [ -n "$REPAIR$NOTE" ] || exit 0  # only daemons it could not restart yet: no log line, no notice
  finish repaired "${NOTE:+Harness landing: ${NOTE#; }.}"
fi
if [ "$STATE" = upgraded ]; then
  log "landing state=$STATE"
  legacy_hooks
  # Before the settings: a landing that waits for a busy daemon has not migrated anything yet.
  restart_daemons || finish waits-daemon "Harness landing waits: a stale git-fswatch daemon is in the middle of its git work; the settings are not touched yet${NOTE:+ (done so far: ${NOTE#; })}; the landing goes on at the next turn end."
  settings || finish "failed-${out:-settings}" "Harness landing failed at the ${out:-settings} step (see logs/landing.log)${NOTE:+ (done so far: ${NOTE#; })}; it runs again at the next turn end."
  NOTE="${out:+; $out}$NOTE"
fi
steps=3,4,5 did="settings.json rendered from the overlay, settings filter registered, pre-commit hook installed"
own_hooks || { steps=3,4; did="${did%, pre-commit*}; pre-commit hook not installed: core.hooksPath comes from the $HOOK_SCOPE git config"; }
[ "$STATE" = hooks ] && steps=5
bash scripts/bootstrap --steps "$steps" 2>&1 | sed -e "s#$H#<home>#g" -e "s#${HOME:-/nonexistent}/#~/#g" >> "$LOG"
[ "${PIPESTATUS[0]}" -eq 0 ] \
  || finish "failed-steps-$steps" "Harness landing failed at init steps $steps (see logs/landing.log)${NOTE:+ (done so far: ${NOTE#; })}; it runs again at the next turn end."
[ "$STATE" = hooks ] && finish hooks-refreshed "Harness landing: init step 5 reinstalled the git hooks that differed from hooks/git-hooks/."
finish landed "Harness landing: P7 landed on this home: $did${NOTE}. Running sessions follow its push and guard settings now; see logs/landing.log."
