#!/usr/bin/env bash
# publish-public — D30: this repository stays private with its full history; the public repository
# starts from ONE parentless commit holding the clean tree and each later publish adds exactly one
# commit to its main: no history is rewritten, none is shared. Usage: publish-public [--dry-run]
# [--source <commit>, default: the local master] <public repository: a URL, a path or a remote's name>.
# The commit (the source's tree; parent: the public main tip, none while main is absent; author and
# committer Yugoge <196512512+Yugoge@users.noreply.github.com> whatever git's identity here, at the
# current time; message "Publish <source id>") is made in a scratch repository that borrows
# this one's objects and alone receives the fetched tip: nothing is written here, and the scratch goes
# on every exit. It is pushed (plain, to main only) once P11's guard beside this script passes in its
# strict mode on that very push: the guard alone reads and decides on this repository's
# private-literals.txt (D24, one rule per artifact), which the scratch holds a link to. It fails
# closed on a missing or empty list, runs P8's engine (default mode) on the tree, files named, then
# scans what the push sends, masking every listed literal in what it shows. Refused (exit 1,
# nothing pushed, the step named): the guard's refusal (its report above), an unreadable source
# or public repository, a public main that this repository's refs reach (a named remote's own
# tracking refs aside) or whose history holds a commit this script did not make (a merge, or a
# message other than "Publish <full commit id>"; the commit named), or a step that cannot run.
# The public main already holding the tree, once the guard has passed: nothing to publish. Usage
# errors exit 2.
set -uo pipefail
refuse() { echo "publish-public: REFUSED: $*" >&2; exit 1; }
usage() { echo "usage: publish-public [--dry-run] [--source <commit>] <public repository>" >&2; exit 2; }
dry= src=refs/heads/master pub= rname= old=
while [ $# -gt 0 ]; do
  case "$1" in --dry-run) dry=1 ;; --source) [ $# -gt 1 ] || usage; src="$2"; shift ;;
    -*) usage ;; *) [ -z "$pub" ] || usage; pub="$1" ;; esac; shift
done
[ -n "$pub" ] || usage
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
guard="$here/install/push-guard"
common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
  && objects="$(git rev-parse --path-format=absolute --git-path objects)" || refuse "not inside a git repository"
list="${common%/*}/private-literals.txt"
[ -f "$guard" ] || refuse "scripts/install/push-guard is missing"
src="$(git rev-parse -q --verify "$src^{commit}")" && tree="$(git rev-parse "$src^{tree}")" \
  || refuse "cannot read the source commit"
# The owner's public GitHub no-reply identity: git's own here (config or environment) may be real.
name="Yugoge" mail="196512512+Yugoge@users.noreply.github.com"
# A relative path: from the top for a remote's URL (where git reads it from), else from here.
if url="$(git remote get-url --push "$pub" 2>/dev/null)"; then
  rname="$pub" base="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
else url="$pub" base="$PWD"; fi
case "$url" in /*) ;; *) [ ! -d "$base/$url" ] || url="$(cd "$base/$url" && pwd)" ;; esac
heads="$(git ls-remote "$url" refs/heads/main 2>/dev/null)" || refuse "cannot read the public repository"
tip="$(awk '$2 == "refs/heads/main" { print $1 }' <<< "$heads")"
if [ -n "$tip" ] && git cat-file -e "$tip^{commit}" 2>/dev/null; then  # held here: does a ref of ours reach it?
  n="$(git rev-list --count "$tip" --not --exclude="refs/remotes/$rname/*" --all)" \
    || refuse "cannot walk this repository's refs"
  [ "$n" != 0 ] || refuse "the public main $tip is a commit this repository's refs reach: it holds private history"
fi
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_ALTERNATE_OBJECT_DIRECTORIES \
  GIT_NAMESPACE GIT_AUTHOR_DATE GIT_COMMITTER_DATE
[ ! -d "$url" ] || [ "$(git -C "$url" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" != "$common" ] \
  || refuse "the public repository is this repository"
t="$(mktemp -d)" || refuse "cannot create a scratch directory"
trap 'rm -rf "$t"' EXIT
# The scratch runs no hook, offers the public host no tip of ours as a "have" when it fetches, and keeps
# the fetched pack: unpacked, an object this repository holds would be freshened (its file touched).
git init -q "$t" && printf '%s\n' "$objects" > "$t/.git/objects/info/alternates" && printf '%s\n' '[core]' \
  'hooksPath = /dev/null' 'alternateRefsCommand = true' '[fetch]' 'unpackLimit = 1' >> "$t/.git/config" \
  && ln -s "$list" "$t/private-literals.txt" || refuse "cannot create the scratch repository"
if [ -n "$tip" ]; then
  git -C "$t" fetch -q --no-tags "$url" refs/heads/main 2>/dev/null && old="$(git -C "$t" rev-parse FETCH_HEAD)" \
    || refuse "cannot fetch the public main"
  [ "$old" = "$tip" ] || refuse "the public main moved during the publish"
  # Publish-only: a commit made elsewhere (a host's initial README, an edit on the public side) is refused.
  odd="$(git -C "$t" rev-list --no-commit-header --format='%x01%H %P%n%B' "$old" | LC_ALL=C awk 'BEGIN { RS = "\001" }
    NR > 1 && odd == "" { i = index($0, "\n"); m = substr($0, i + 1); split(substr($0, 1, i - 1), f, " ")
      if (f[3] != "" || m !~ /^Publish [0-9a-f]+\n\n$/ || length(m) != length(f[1]) + 10) odd = f[1] }
    END { print odd }')" || refuse "cannot walk the public main"
  [ -z "$odd" ] || refuse "the public main holds commit $odd, which this script did not make (a merge, or a" \
    "message other than \"Publish <full commit id>\"): the public repository is publish-only"
fi
new="$(GIT_AUTHOR_NAME="$name" GIT_AUTHOR_EMAIL="$mail" GIT_COMMITTER_NAME="$name" \
  GIT_COMMITTER_EMAIL="$mail" git -C "$t" commit-tree "$tree" ${old:+-p "$old"} -m "Publish $src")" \
  || refuse "cannot create the publish commit"
printf 'refs/heads/main %s refs/heads/main %s\n' "$new" "${old:-${new//?/0}}" \
  | (cd "$t" && bash "$guard" --strict "${rname:-$url}" "$url") \
  || refuse "scripts/install/push-guard --strict refused the publish (its report above)"
[ -z "$old" ] || [ "$(git -C "$t" rev-parse "$old^{tree}")" != "$tree" ] \
  || { echo "publish-public: nothing to publish: the public main $old already holds tree $tree"; exit 0; }
what="$new (tree $tree, parent ${old:-none}) to the public main"
[ -z "$dry" ] || { echo "publish-public: dry run: would push $what; nothing pushed"; exit 0; }
report="$(git -C "$t" push -q "$url" "$new:refs/heads/main" 2>&1)" \
  || { printf '%s\n' "${report//"$url"/<public repository>}" >&2; refuse "the push to the public main failed"; }
echo "publish-public: published $what"
