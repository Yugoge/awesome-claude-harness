# Claude Code .gitignore

# Credentials and secrets
.credentials.json
*.key
*.pem
# The secrets file hooks/.env.example tells users to create in the harness home
/.env

# Local settings (user-specific)
settings.local.json
# Machine overlay rendered into settings.json by the settings filter; personal values, never tracked
/settings.machine.json
# Private-literal list read by the pre-commit check; its literals are personal, never tracked
/private-literals.txt
# render-settings' temp file for its atomic write of settings.json; one left by an interrupted render holds the machine form
/.settings.render.*

# Temporary files
*.tmp
*.log

# Session data (may contain sensitive tokens)
todos/
shell-snapshots/
debug/
/projects/

# Plugin data (may contain tokens)
plugins/
statsig/

# History
history.jsonl

# Node modules (if any)
node_modules/

# Python virtual environments
venv/
env/
.venv/
__pycache__/

# OS files
.DS_Store
Thumbs.db

# Backups
*.backup
*.bak
# scripts/bootstrap's backups of the venv and of settings.json, <name>.bak-<timestamp>
/*.bak-*
# hooks/install.sh's backup of settings.json
/settings.json.backup.*

logs/*
session-env/

# File history (contains session data, may include secrets)
file-history/

# doc-sync runtime cache (hooks/userprompt-doc-sync-check.py)
/.doc-sync-cache.json

# MCP auth runtime cache
mcp-needs-auth-cache.json

# Claude Code's live session records
sessions/

# Claude Code's cleanup stamp, and the browser cookie file of a Playwright MCP run with a storage-state file
.last-cleanup
playwright-storage-state.json

# What the commands write under docs/ (docs/dev, docs/codex, docs/clean, docs/test, ...);
# docs/reference/ and the documentation files directly in docs/ stay visible
docs/*/
!docs/reference/
# The folder index and readme doc-sync once created there and /clean's cleaner writes
/docs/INDEX.md
/docs/README.md

# Per-run enforcement-evidence manifest. Regenerated by
# hooks/tests/test_blackbox_integration.py on every run and published as a CI artifact;
# it must NEVER be committed. A checked-in manifest is evidence of authorship rather than
# of execution, which is the exact failure the --coverage gate exists to detect.
hooks/tests/.enforcement-run-manifest.json

# The old score store: nothing writes it any more (the scores live in logs/lifecycle.jsonl), and homes
# still hold it; kept under D28 with logs/*
/agent-scores.json
/agent-scores.json.lock

# The seal store's default before it moved under state/; homes still hold it
/attribution-seals/

# Live per-machine Claude state — credentials + runtime; NEVER commit
# (.claude.json holds machineID/userID/oauthAccount/email)
/.claude.json

# Project-level runtime state, <project>/.claude/<name>. The project can be this home
# (a nested .claude/) or $HOME (this home's own root), so one unanchored name covers both.
# Directory-pattern matching is path-component-exact, not substring:
# paseo-daemon/ cannot match commands/paseo-daemon.md or scripts/paseo-daemon-ledger.py.
workflow-*.json
dev-registry/
worktrees/
workflow-locks/
dev-start-replays/
.hook-refactor-allow
paseo-daemon/
scratch/
session-resources/
workflow-history/
overnight-fresh-clones/
overnight-git-bin/
overnight-git-policy-bin/
overnight-state-*.json
overnight-contract-*.json
overnight-delivery-*.json
/specs/
/.claude/specs/
# state/ also holds the attribution journal and its seal store (state/attribution-seals/)
/state/
/.claude/state/

# test-writer's per-task tests and /test's reports, when this home is the project
/tests/generated/
/tests/reports/

# Browser tools' output: the Playwright MCP directory and screenshots saved in the working directory
.playwright-mcp/
/*.png

# Graphify knowledge graph transient output (spec-20260527-061433)
graphify-out/

# Claude Code's and the harness's runtime directories in this home
/archive/
backups/
/cache/
paste-cache/
plans/
restart-state/
tasks/
