# Claude Code .gitignore

# Credentials and secrets
.credentials.json
*.key
*.pem

# Local settings (user-specific)
settings.local.json

# Temporary files
*.tmp
*.log

# Session data (may contain sensitive tokens)
todos/
shell-snapshots/
debug/
projects/

# Plugin data (may contain tokens)
plugins/
statsig/

# History
history.jsonl

# Node modules (if any)
node_modules/

# Python virtual environments
venv/
env/
.venv/
*.pyc
__pycache__/

# OS files
.DS_Store
Thumbs.db

# Backups
*.backup
*.bak

logs/*
# PERMITTED DELIVERY PATH: logs/lifecycle.jsonl is the R9 in-repo lifecycle log (spec-20260520-221059 binding constraint)
session-env/
systemd/

# File history (contains session data, may include secrets)
file-history/

# doc-sync runtime cache
.doc-sync-cache.json

# MCP auth runtime cache
mcp-needs-auth-cache.json

# Live session telemetry (was previously tracked; rm --cached old ones)
sessions/

# Dev cycle output and session state (not for version control)
.last-cleanup
playwright-storage-state.json
.todos.json
docs/*
# PERMITTED DELIVERY PATH: docs/reference/ holds in-repo documentation deliverables (arch-1/D3, spec-20260520-221059)
!docs/reference/
!docs/THREAT-MODEL.md
# PERMITTED DELIVERY PATH: the published trust/proof artifacts. These are companions to
# docs/THREAT-MODEL.md above and are load-bearing in CI, not dev-cycle scratch output:
# scripts/verify-claims.sh gates the required `baseline` job on them via
# scripts/check-enforcement-evidence.py --ledger/--claims, and CI runs from a fresh
# checkout. Left under the blanket docs/* ignore they would be absent there and every
# enforcement-evidence check would fail on a file it could not read.
!docs/ENFORCEMENT-LEDGER.md
!docs/ADVERSARIAL-CORPUS.md

# Per-run enforcement-evidence manifest. Regenerated by
# hooks/tests/test_blackbox_integration.py on every run and published as a CI artifact;
# it must NEVER be committed. A checked-in manifest is evidence of authorship rather than
# of execution, which is the exact failure the --coverage gate exists to detect.
hooks/tests/.enforcement-run-manifest.json

# Live workflow / dev coordination state
workflow-*.json
dev-registry/
specs/*/cp-state-*.json

# Spec checkpoint state, worktrees, and rotating .claude.json backups
specs/spec-*/
worktrees/
backups/.claude.json.backup.*
settings.json.bak-*

# Runtime telemetry (spec-20260518-225715 Cycle 2 P2.3 — root-anchored;
# previously leaked because the generic specs/spec-*/ rule above is relative
# and does not match .claude/specs/...)
/agent-scores.json
/agent-scores.json.lock
/.claude/specs/spec-*/

# Live per-machine Claude state — credentials + runtime; NEVER commit
# (.claude.json holds machineID/userID/oauthAccount/email)
/.claude.json

# Runtime coordination/replay/daemon state. This repo's own root doubles as
# the .claude/ dir referenced elsewhere (self-hosted /dev-overnight cycles
# also grow a genuine nested .claude/), so the same runtime dir can exist at
# BOTH depths at once. The root-anchored /.claude/<name>/ forms previously
# here matched only the nested copy, never the top-level one, and were
# inert since introduction (34c2b0d0, 2026-07-26) — fixed here in
# dev-20260915-051511-a. Unanchored basename patterns (no leading/internal
# slash) match at any depth per git's own
# gitignore(5) semantics, so one line per name below covers both depths now
# and any future nesting layer without going silently inert again.
# Directory-pattern matching is path-component-exact, not substring:
# paseo-daemon/ cannot match commands/paseo-daemon.md or
# scripts/paseo-daemon-ledger.py (verified via git check-ignore -v, exit 1).
workflow-locks/
dev-start-replays/
.hook-refactor-allow
paseo-daemon/
scratch/
workflow-history/
overnight-git-bin/
overnight-git-policy-bin/

# /dev-overnight session runtime state (schema state + per-cycle contract) and
# test-writer's throwaway one-off generation scripts — same any-depth basename
# rationale as the block above.
overnight-state-*.json
overnight-contract-*.json
tw-gen-*.py
overnight-delivery-*.json

# Stray root-level scratch fragment (2026-09-17 sweep); root-anchored since
# this is a single stray file, not a repeatable runtime-state pattern.
/downstream

# Harness-generated output (transient per-cycle; not for version control)
# tests/generated/ bulk-untracked; only 20260704-134650 and 20260704-225139 retained
# (ignore children, not parent dir — git negations cannot re-include children of an ignored dir)
tests/generated/*
# The global index (kind:"index", tasks[] -> per-task manifest_path) is TRACKED:
# test-writer upserts one entry per task, so it must survive version control even
# though every per-task dir beside it is bulk-ignored. Without this negation the
# tracked file is a gitignored deliverable and pretool-gitignore-preflight.py
# blocks the next Agent dispatch on every cycle that runs test-writer.
!tests/generated/manifest.json
!tests/generated/20260704-134650/
!tests/generated/20260704-134650/**
!tests/generated/20260704-225139/
!tests/generated/20260704-225139/**
tests/generated/*/__pycache__/
# _work/ is pytest RUNTIME SCRATCH (ac_harness.py WORKBASE; recreated every run,
# incl. nested throwaway git repos) and must NEVER be committed for any task
tests/generated/*/_work/
tests/generated/*/_work/**
docs/codex/
.playwright-mcp/

# dot-claude-specific: screenshots from browser tools (not propagated to child repos)
*.png
# harness-propagated by session-gitignore-propagate.sh
.claude/dev-registry/dev-*/

# Graphify knowledge graph transient output (spec-20260527-061433)
graphify-out/

# dev workflow artifacts — never tracked (global policy)
docs/dev/

# Runtime/transient dirs (global no-track policy)
archive/
backups/
cache/
eval/
logs/
paste-cache/
plans/
specs/
state/
restart-state/
tasks/

# Belt-and-suspenders: auto-generated folder-doc stubs must never re-enter
# version control under the GitHub-reserved .github/ subtree (the generators
# already skip it; these patterns catch any future regression). '**' matches
# zero-or-more directories, so .github/**/README.md also covers .github/README.md.
.github/**/README.md
.github/**/INDEX.md
.github/INDEX.md
