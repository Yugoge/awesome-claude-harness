#!/usr/bin/env bash
# claude-harness pre-commit (installed by scripts/bootstrap)
# Fail-closed: every step refuses the commit when its check fails OR its script (taken from
# this repository's working tree, never a home directory) is missing, and prints one line
# naming the failed check. A hook displaced by the install runs last as pre-commit.local.
set -u

refuse() {
  echo "pre-commit: commit REFUSED by the $*" >&2
  exit 1
}
need() { [ -f "$top/$2" ] || refuse "$1: $2 is missing"; }

# Resolved before changing directory: git may run the hook by a relative path.
hook_dir="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" \
  || refuse "hook check: cannot resolve the directory this hook runs from"
top="$(git rev-parse --show-toplevel 2>/dev/null)" && [ -n "$top" ] && cd "$top" \
  || refuse "repository check: cannot find or enter the top of the working tree"

# 1. Untracked-file policy first: with GIT_AUTO_STAGE_ALL=1 it stages files the checks below must see.
need "untracked-file check" hooks/pre-commit-check.sh
bash "$top/hooks/pre-commit-check.sh" || refuse "untracked-file check: hooks/pre-commit-check.sh failed"

# 2. settings.json staged in clean form.
need "settings check" scripts/install/render-settings
python3 "$top/scripts/install/render-settings" check --staged \
  || refuse "settings check: scripts/install/render-settings check --staged failed"

# 3. No listed private literal added by this commit (report shown only on refusal).
need "private-literal check" scripts/check-public-core.sh
if ! report="$(bash "$top/scripts/check-public-core.sh" --private-literals 2>&1)"; then
  printf '%s\n' "$report" >&2
  refuse "private-literal check: scripts/check-public-core.sh --private-literals failed"
fi

# 4. Sentinel lint, only when an orchestrator file (dev.md, dev-command.md, dev-overnight.md) is staged.
staged="$(git diff --cached --name-only)" || refuse "sentinel lint: cannot list the staged paths"
if printf '%s\n' "$staged" | grep -qE '^commands/dev(\.md|-command\.md|-overnight\.md)$'; then
  need "sentinel lint" hooks/sentinel-lint.sh
  bash "$top/hooks/sentinel-lint.sh" || refuse "sentinel lint: hooks/sentinel-lint.sh failed"
fi

# 5. Chain to the displaced hook, if any.
[ -x "$hook_dir/pre-commit.local" ] && exec "$hook_dir/pre-commit.local" "$@"
exit 0
