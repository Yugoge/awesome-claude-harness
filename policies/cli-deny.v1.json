{
  "schema": "cli-deny.v1",
  "about": "The refusals that were Claude Code's own permissions.deny in settings.json, decided since 2026-11-21 by the pre-tool rule hooks/pretool-deny-list.py (matcher: hooks/lib/deny_list.py), so that each is recorded and an owner's /allow releases it. The entries keep the CLI's syntax and order: Bash(<command pattern>), Read(<path>), Edit(<path>), Skill(<name>); for Read and Edit the last matching entry of the tool's list wins and a leading ! lifts. purposes: the first whose pattern matches an entry says what it is for; the refusal text quotes it.",
  "purposes": [
    {
      "match": "^Skill\\(",
      "kind": "owner-only",
      "purpose": "an owner-only command: the model does not invoke it; its effects are made by hooks at the owner's own typed prompt"
    },
    {
      "match": "session_dirs",
      "kind": "session-registry",
      "purpose": "the session-directory registry: no agent reads, writes or runs it"
    },
    {
      "match": "^Bash\\(git (push (--force|-f)|reset --hard)[ :]",
      "kind": "git-history",
      "purpose": "a git command that destroys history (force push, hard reset)"
    },
    {
      "match": "^Bash\\((rm -rf /|mkfs)",
      "kind": "filesystem",
      "purpose": "a removal of the root or a new filesystem"
    },
    {
      "match": "^Bash\\((halt|poweroff|reboot|shutdown|systemctl )",
      "kind": "host",
      "purpose": "the host's power or its services"
    },
    {
      "match": "^Bash\\(su(do)?[ :]",
      "kind": "privilege",
      "purpose": "a change of user or privilege (su, sudo)"
    },
    {
      "match": "^Bash\\((docker rm|kubectl delete|yarn publish)[ :]",
      "kind": "outward",
      "purpose": "a container or cluster removal, or a package publish"
    },
    {
      "match": "^Edit\\(\\.claude/",
      "kind": "harness-file",
      "purpose": "a harness file of the project: its hooks, scripts, settings or CLAUDE.md"
    },
    {
      "match": "^Edit\\(/\\.?venv/",
      "kind": "harness-venv",
      "purpose": "the virtual environment whose interpreter the registered hooks run"
    },
    {
      "match": "^(Read|Edit)\\(!",
      "kind": "lift",
      "purpose": "a lift: it re-admits what an earlier entry of the same tool's list refused (last match wins)"
    },
    {
      "match": "^(Read|Edit)\\(",
      "kind": "secret-file",
      "purpose": "a secret file (credentials, keys, passwords, .env files)"
    }
  ],
