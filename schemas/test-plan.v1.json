{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "test-plan.v1",
  "title": "PM Test Plan",
  "description": "The test plan PM writes in /dev-overnight PLAN mode (agents/pm.md, Test Plan Schema), at the path its dispatch obligation declares; G2 checks it at PM's own stop. Required here is what the orchestrator and the specialists read from it: the app's URL, an assignment per specialist, the core-flow gate the user specialist owns, firsthand browser evidence unless the app was not running, and the degradation check of every recommended specialist. task_id is the identity the obligation names. Every other field of the PM payload is allowed.",
  "type": "object",
  "additionalProperties": true,
  "required": ["task_id", "app_context", "agent_assignments", "core_flow_gate", "pm_experience"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "app_context": {"type": "object", "required": ["url"]},
    "agent_assignments": {
      "type": "object",
      "required": ["user", "product-owner", "architect", "ui-specialist"]
    },
    "core_flow_gate": {
      "type": "object",
      "required": ["owner", "failure_is_cycle_failure"],
      "properties": {
        "owner": {"const": "user"},
        "failure_is_cycle_failure": {"const": true}
      }
    },
    "pm_experience": {
      "type": "object",
      "if": {
        "properties": {"app_not_running": {"const": true}},
        "required": ["app_not_running"]
      },
      "else": {
        "required": ["urls_visited", "actions_taken"],
        "properties": {
          "urls_visited": {"type": "array", "minItems": 1},
          "actions_taken": {"type": "array", "minItems": 1}
        }
      }
    },
    "recommended_specialists": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["degradation_check"],
        "properties": {"degradation_check": {"type": "object"}}
      }
    }
  }
}
